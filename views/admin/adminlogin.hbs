<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Login - ShopHub</title>
    <link rel="stylesheet" href="/seller/seller-login.css">
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="navbar-brand">
                <a href="#" class="logo">ShopHub</a>
            </div>
        </div>
    </nav>

    <!-- Login Section -->
    <main class="auth-section">
        <div class="auth-container">

            <!-- Login Card -->
            <div class="auth-card">

                <h1 class="auth-heading">Admin Login</h1>
                <p class="auth-subtitle">Access your ShopHub dashboard</p>

                <form class="auth-form"  method="post" action="/admin/login">
{{!-- id="loginForm" --}}
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="you@example.com" required>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="Enter your password" required>
                    </div>
                    <button type="submit" class="btn btn-primary btn-full">Login</button>

                    <!-- Added Register Button -->
            
                </form>
            </div>

            <!-- Right Side Illustration -->
          <div class="seller-image">
    <div class="seller-illustration">

        <img 
            src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0"
            class="seller-img"
            alt="Online Shopping"
        >

        <h2>Sell to Millions</h2>
        <p>Join ShopHub Seller Center and grow your business</p>
    </div>
</div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2025 ShopHub. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>
