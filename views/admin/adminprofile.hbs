<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - ShopHub</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --primary: #3b42c5;
            --secondary: #3917e4;
            --success: #4cc9f0;
            --warning: #f72585;
            --light: #f8f9fa;
            --dark: #212529;
            --gray: #6c757d;
            --light-gray: #e9ecef;
            --radius: 12px;
        }

        * {
            padding: 0;
            margin: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f5f7fb;
            color: var(--dark);
            min-height: 100vh;
            display: flex;
        }

        /* SIDEBAR */
        .sidebar {
            width: 260px;
            background: linear-gradient(to bottom, var(--primary), var(--secondary));
            color: white;
            min-height: 100vh;
            position: fixed;
            display: flex;
            flex-direction: column;
            box-shadow: 3px 0 12px rgba(0, 0, 0, 0.1);
            z-index: 1000;
        }

        .sidebar-header {
            padding: 20px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .sidebar-header h2 {
            font-size: 1.5rem;
            margin-left: 10px;
        }

        /* Admin Profile In Sidebar */
        .admin-profile {
            padding: 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .admin-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7rem;
            font-weight: bold;
            margin: 0 auto 10px auto;
        }

        .admin-profile h3 {
            margin: 0;
            font-size: 1.2rem;
        }

        .admin-profile p {
            margin: 0;
            font-size: 0.85rem;
            opacity: 0.9;
        }

        /* Sidebar Menu */
        .sidebar-menu {
            margin-top: 10px;
            flex: 1;
        }

        .sidebar-menu ul {
            list-style: none;
        }

        .sidebar-menu li {
            padding: 13px 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            transition: 0.3s;
        }

        .sidebar-menu li.active {
            background-color: rgba(255, 255, 255, 0.2);
            border-left: 4px solid white;
        }

        .sidebar-menu li:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

        .sidebar-menu i {
            margin-right: 12px;
        }

        /* Footer Logout */
        .sidebar-footer {
            padding: 18px 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .sidebar-footer a {
            color: white;
            text-decoration: none;
            font-size: 0.95rem;
        }

        /* MAIN CONTENT */
        .main-content {
            margin-left: 260px;
            padding: 20px;
            width: calc(100% - 260px);
        }

        .header {
            display: flex;
            justify-content: space-between;
            border-bottom: 1px solid var(--light-gray);
            padding-bottom: 15px;
        }

        .header h1 {
            color: var(--primary);
            font-size: 1.8rem;
        }

        .admin-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .admin-info .admin-info-avatar {
            width: 40px;
            height: 40px;
            background: var(--primary);
            color: white;
            font-weight: bold;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* SECTION */
        .section {
            display: none;
            animation: fadeIn 0.3s ease-in-out;
        }

        .section.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* CARDS */
        .stats-container {
            margin-top: 20px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
        }

        .stat-card {
            background: white;
            border-radius: var(--radius);
            padding: 20px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
            display: flex;
            gap: 15px;
            transition: 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-4px);
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            background: rgba(0, 0, 0, 0.05);
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
        }

        .stat-info h3 {
            margin: 0;
            font-size: 1.7rem;
        }

        .stat-info p {
            margin: 0;
            color: var(--gray);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
        }

        .section-header h2 {
            margin: 0;
        }

        .admin-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.04);
        }

        .admin-table th,
        .admin-table td {
            padding: 12px 15px;
            border-bottom: 1px solid var(--light-gray);
            font-size: 0.9rem;
            text-align: left;
        }

        .admin-table th {
            background-color: var(--light);
            font-weight: 600;
        }

        .status {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .status.active {
            background-color: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }

        .status.suspended {
            background-color: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }

        .admin-action-btn {
            border: none;
            background: none;
            cursor: pointer;
            font-size: 0.8rem;
            padding: 4px 8px;
            border-radius: 6px;
        }

        .admin-action-btn.suspend {
            color: #dc3545;
        }

        .sellers-grid {
            margin-top: 20px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 18px;
        }

        .seller-card {
            background: white;
            border-radius: 12px;
            padding: 16px 18px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.04);
        }

        .seller-card h3 {
            margin: 0 0 6px 0;
            font-size: 1.05rem;
        }

        .seller-info {
            margin: 2px 0;
            font-size: 0.85rem;
            color: var(--gray);
        }

        .seller-card .status {
            margin-top: 8px;
        }

        footer.admin-footer {
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px solid var(--light-gray);
            font-size: 0.85rem;
            color: var(--gray);
            text-align: center;
        }

        @media (max-width: 992px) {
            footer.admin-footer {
                margin-left: 0;
            }
        }
    </style>
</head>

<body>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="sidebar-header">
            <i class="fas fa-shield-alt fa-2x"></i>
            <h2>Admin Panel</h2>
        </div>

        <div class="admin-profile">
            <div class="admin-avatar">A</div>
            <h3>Administrator</h3>
            <p>System Manager</p>
        </div>

        <div class="sidebar-menu">
            <ul>
                <li class="active" data-section="dashboard">
                    <i class="fas fa-tachometer-alt"></i> <span>Dashboard</span>
                </li>
                <li data-section="users">
                    <i class="fas fa-users"></i> <span>Users</span>
                </li>
                <li data-section="sellers">
                    <i class="fas fa-user-tie"></i> <span>Sellers</span>
                </li>
                <li data-section="categories">
                    <i class="fas fa-tags"></i> <span>Categories</span>
                </li>

            </ul>
        </div>

        <div class="sidebar-footer">
            <a href="/admin/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </div>


    <!-- MAIN CONTENT -->
    <div class="main-content">


        <div class="header">
            <h1 id="pageTitle">Dashboard</h1>

            <div class="admin-info">
                <div class="admin-info-avatar">A</div>
                <div>
                    <h4 style="margin:0;">Admin</h4>
                    <p style="margin:0;font-size:0.85rem;color:var(--gray);">Administrator</p>
                </div>
            </div>
        </div>

        <!-- DASHBOARD SECTION -->
        <div id="dashboard" class="section active">

            <div class="stats-container">

                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-info">
                        <h3>{{usercount}}</h3>
                        <p>Total Users</p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <div class="stat-info">
                        <h3>{{sellercount}}</h3>
                        <p>Active Sellers</p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <div class="stat-info">
                        <h3>{{totalorder}}</h3>
                        <p>Total Orders</p>
                    </div>
                </div>

                {{!-- <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-coins"></i>
                    </div>
                    <div class="stat-info">
                        <h3>$2.4M</h3>
                        <p>Total Revenue</p>
                    </div>
                </div> --}}
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-tags"></i>
                    </div>
                    <div class="stat-info">
                        <h3>{{categorycount}}</h3>
                        <p>Total Categories</p>
                    </div>
                </div>


            </div>

        </div>
        <!-- USERS & SELLERS EXTRA STYLES -->


        <!-- USERS SECTION -->
        <div id="users" class="section">
            <div class="section-header">
                <h2>Users Management</h2>
                {{!-- You can add search/filter here later --}}
            </div>

            <table class="admin-table">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Join Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#if user}}
                    {{#each user}}
                    <tr>
                        <td>U-{{inc @index}}</td>
                        <td>{{this.name}}</td>
                        <td>{{this.email}}</td>
                        <td>{{this.approvedAt}}</td>
                        <td>
                            <span class="status active">Active</span>
                        </td>
                        <td>
                            <button class="admin-action-btn suspend">
                                Suspend
                            </button>
                        </td>
                    </tr>
                    {{/each}}
                    {{else}}
                    <tr>
                        <td colspan="6" class="text-center text-muted">
                            No users found.
                        </td>
                    </tr>
                    {{/if}}
                </tbody>
            </table>
        </div>

        <!-- SELLERS SECTION -->
        <div id="sellers" class="section">
            <div class="section-header">
                <h2>Sellers Management</h2>
                {{!-- <button class="btn btn-primary btn-sm">Add Seller</button> --}}
            </div>

            <div class="sellers-grid">
                {{#if seller}}
                {{#each seller}}
                <div class="seller-card">
                    <h3>{{this.name}}</h3>
                    <p class="seller-info">📧 {{this.email}}</p>
                    {{#if this.phone}}
                    <p class="seller-info">📱 {{this.phone}}</p>
                    {{/if}}
                    {{!-- <p class="seller-info">⭐ 4.8/5 (1,245 reviews)</p> --}}
                    <p class="seller-info">📦{{this.products.length}}  products</p>
                    {{!-- <p class="seller-info">💰 $18,000 revenue</p> --}}
                    <span class="status active">Verified</span>
                </div>
                {{/each}}
                {{else}}
                <p class="text-muted">No sellers found.</p>
                {{/if}}
            </div>
        </div>
        <!-- CATEGORIES SECTION -->
        <div id="categories" class="section">
            <div class="section-header">
                <h2>Categories Management</h2>
                <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                    <i class="fas fa-plus"></i> Add Category
                </button>

            </div>

            <table class="admin-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Category Name</th>
                        {{!-- <th>Total Products</th> --}}
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    {{#if category}}
                    {{#each category}}
                    <tr>
                      <td>{{inc @index}}</td>

                        <td>{{this.name}}</td>
                        {{!-- <td>{{this.productCount}}</td> --}}
                        <td>
                            <span class="status active">Active</span>
                        </td>
                        <td>
                            <form action="/admin/category/delete/{{this.id}}" method="POST" style="display:inline;">
                            <button type="submit" class="admin-action-btn suspend"
                            onclick="return confirm('Delete this category?')">
                            <i class="fas fa-trash"></i>
                            </button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                    {{else}}
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            No categories found.
                        </td>
                    </tr>
                    {{/if}}
                </tbody>

            </table>
        </div>
        <!-- ADD CATEGORY MODAL -->
        <div class="modal fade" id="addCategoryModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content p-3">

                    <h4 class="mb-3">Add New Category</h4>

                    <form action="/admin/category/add" method="POST" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label class="form-label">Category Name</label>
                            <input type="text" name="name" class="form-control" placeholder="Enter category name"
                                required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea name="description" class="form-control"
                                placeholder="Write something..."></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Category Image</label>
                            <input type="file" name="image" class="form-control" accept="image/*" required>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Add Category</button>

                    </form>

                </div>
            </div>
        </div>


        <!-- FOOTER -->
        <footer class="admin-footer">
            &copy; 2025 ShopHub Admin. All rights reserved.
        </footer>

    </div> <!-- /main-content -->

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Sidebar navigation - switch sections
        document.querySelectorAll('.sidebar-menu li').forEach(item => {
            item.addEventListener('click', function () {
                // Active menu item
                document.querySelectorAll('.sidebar-menu li').forEach(li => li.classList.remove('active'));
                this.classList.add('active');

                // Show corresponding section
                const target = this.getAttribute('data-section');
                document.querySelectorAll('.section').forEach(sec => sec.classList.remove('active'));
                const sectionEl = document.getElementById(target);
                if (sectionEl) sectionEl.classList.add('active');

                // Update title
                const span = this.querySelector('span');
                document.getElementById('pageTitle').textContent = span ? span.textContent : 'Dashboard';
            });
        });
    </script>

</body>

</html>