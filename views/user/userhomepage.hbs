<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>LookMe - Flipkart Style E-Commerce</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="userhomepage.css">
<body>

  <!-- ===== NAVBAR ===== -->
  <nav class="navbar navbar-expand-lg navbar-dark sticky-top shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="#">Loop<span>Store</span></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <form class="d-flex mx-auto search-bar" method="post">
          <input class="form-control" type="search" name="search" placeholder="Search for Products, Brands and More" />
          <button class="btn"><i class="bi bi-search"></i></button>
        </form>
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link" href="#"><i class="bi bi-person-circle"></i> Login</a></li>
          <li class="nav-item"><a class="nav-link" href="#"><i class="bi bi-cart3"></i> Cart</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- ===== HERO CAROUSEL ===== -->
  <div class="container mt-4">
    <div id="mainCarousel" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-inner rounded">
        <div class="carousel-item active"><img src="https://picsum.photos/1200/400?1" class="d-block w-100" alt=""></div>
        <div class="carousel-item"><img src="https://picsum.photos/1200/400?2" class="d-block w-100" alt=""></div>
        <div class="carousel-item"><img src="https://picsum.photos/1200/400?3" class="d-block w-100" alt=""></div>
      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
      </button>
    </div>
  </div>

  <!-- ===== CATEGORY SECTION ===== -->
 <div class="container mt-4">
  <div class="d-flex justify-content-between overflow-auto">

    <a href="/user/usercategorypage?cat=mobiles" class="category-item mx-2">
      <img src="https://picsum.photos/100/100?1" alt="">
      <p class="mt-2 fw-semibold">Electrol</p>
    </a>

    <a href="/user/usercategorypage?cat=fashion" class="category-item mx-2">
      <img src="https://picsum.photos/100/100?2" alt="">
      <p class="mt-2 fw-semibold">Fashion</p>
    </a>

    <a href="/user/usercategorypage?cat=electronics" class="category-item mx-2">
      <img src="https://picsum.photos/100/100?3" alt="">
      <p class="mt-2 fw-semibold">Electronics</p>
    </a>

    <a href="/user/usercategorypage?cat=home" class="category-item mx-2">
      <img src="https://picsum.photos/100/100?4" alt="">
      <p class="mt-2 fw-semibold">Home</p>
    </a>

    <a href="/user/usercategorypage?cat=beauty" class="category-item mx-2">
      <img src="https://picsum.photos/100/100?5" alt="">
      <p class="mt-2 fw-semibold">Beauty</p>
    </a>

    <a href="/user/usercategorypage?cat=appliances" class="category-item mx-2">
      <img src="https://picsum.photos/100/100?6" alt="">
      <p class="mt-2 fw-semibold">Appliances</p>
    </a>

  </div>
</div>


  <!-- ===== AD BANNER ===== -->
  <div class="container mt-4 ad-banner">
    <img src="https://picsum.photos/1200/200?ad" alt="Top Deals Banner">
  </div>

  <!-- ===== TOP OFFERS ===== -->
  <div class="container mt-5">
    <div class="section-title">Top Offers</div>
    <div class="row g-3 bg-white p-3 rounded-bottom">
      <div class="col-6 col-md-3"><div class="card product-card text-center p-2"><img src="https://picsum.photos/200/180?7" alt=""><h6>Smart TVs</h6><p class="price">Up to 45% Off</p></div></div>
      <div class="col-6 col-md-3"><div class="card product-card text-center p-2"><img src="https://picsum.photos/200/180?8" alt=""><h6>Refrigerators</h6><p class="price">Up to 35% Off</p></div></div>
      <div class="col-6 col-md-3"><div class="card product-card text-center p-2"><img src="https://picsum.photos/200/180?9" alt=""><h6>Air Conditioners</h6><p class="price">Up to 30% Off</p></div></div>
      <div class="col-6 col-md-3"><div class="card product-card text-center p-2"><img src="https://picsum.photos/200/180?10" alt=""><h6>Laptops</h6><p class="price">Up to 40% Off</p></div></div>
    </div>
  </div>

  <!-- ===== TOP PICKS + FURNITURE AD SECTION ===== -->
  <div class="container mt-5">
    <div class="row g-3">
      <!-- Left -->
      <div class="col-md-8">
        <div class="bg-white p-3 rounded shadow-sm">
          <h5 class="fw-bold mb-3">Top Picks of the Sale</h5>
          <div class="row g-3">
            <div class="col-6 col-md-3"><div class="card product-card text-center p-2"><img src="https://rukminim2.flixcart.com/image/416/416/xif0q/riding-glove/f/v/m/full-finger-motorcycle-riding-gloves-original-imahyg6czszybqfg.jpeg?q=70" alt=""><h6>Riding Gloves</h6><p class="price">Min. 50% Off</p></div></div>
            <div class="col-6 col-md-3"><div class="card product-card text-center p-2"><img src="https://rukminim2.flixcart.com/image/416/416/kq6yefk0/diaper/y/x/n/-original-imag496xvmvpb3zp.jpeg?q=70" alt=""><h6>Baby Diapers</h6><p class="price">Min. 30% Off</p></div></div>
            <div class="col-6 col-md-3"><div class="card product-card text-center p-2"><img src="https://rukminim2.flixcart.com/image/416/416/klscivk0/headlight/6/j/x/universal-motorcycle-headlight-spotlight-auxiliary-led-driving-original-imagyvkvhzjgdgmy.jpeg?q=70" alt=""><h6>Headlights</h6><p class="price">Min. 50% Off</p></div></div>
            <div class="col-6 col-md-3"><div class="card product-card text-center p-2"><img src="https://rukminim2.flixcart.com/image/416/416/k5msb680/chips/a/q/f/100-potato-chips-yellow-original-imafz9g6wrg8uzyn.jpeg?q=70" alt=""><h6>Chips</h6><p class="price">Min. 50% Off</p></div></div>
          </div>
        </div>
      </div>

      <!-- Right -->
      <div class="col-md-4">
        <div class="furniture-ad p-4 h-100 text-center shadow-sm">
          <h5 class="fw-bold text-brown">Find furniture that speaks to you</h5>
          <p class="text-muted">Discover our Premium Furniture Collection!</p>
          <div class="d-flex justify-content-around mt-3 mb-3">
            <img src="https://rukminim2.flixcart.com/image/416/416/xif0q/recliner/n/6/t/-original-imagrnuekjfhk45h.jpeg?q=70" width="60" height="60" class="rounded" alt="">
            <img src="https://rukminim2.flixcart.com/image/416/416/xif0q/swing/h/n/t/hanging-swing-chair-with-cushion-outdoor-patio-garden-balcony-original-imagxxthq9kzxfby.jpeg?q=70" width="60" height="60" class="rounded" alt="">
            <img src="https://rukminim2.flixcart.com/image/416/416/l3hmwsw0/recliner/n/g/p/-original-imageh7vh4yzgcqj.jpeg?q=70" width="60" height="60" class="rounded" alt="">
          </div>
          <button class="btn btn-warning rounded-pill">See Collection →</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== DEALS OF THE DAY ===== -->
  <div class="container mt-5">
    <div class="section-title">Deals of the Day</div>
    <div class="row g-3 bg-white p-3 rounded-bottom">
      <div class="col-6 col-md-3"><div class="card product-card text-center p-2"><img src="https://picsum.photos/200/180?11" alt=""><h6>Smartphone</h6><p class="price">₹12,999</p><p class="offer">20% Off</p></div></div>
      <div class="col-6 col-md-3"><div class="card product-card text-center p-2"><img src="https://picsum.photos/200/180?12" alt=""><h6>Bluetooth Headphones</h6><p class="price">₹2,499</p><p class="offer">Save ₹500</p></div></div>
      <div class="col-6 col-md-3"><div class="card product-card text-center p-2"><img src="https://picsum.photos/200/180?13" alt=""><h6>Men’s Sneakers</h6><p class="price">₹1,299</p><p class="offer">50% Off</p></div></div>
      <div class="col-6 col-md-3"><div class="card product-card text-center p-2"><img src="https://picsum.photos/200/180?14" alt=""><h6>Smartwatch</h6><p class="price">₹3,499</p><p class="offer">Special Deal</p></div></div>
    </div>
  </div>

  <!-- ===== INFO STRIP ===== -->
  <div class="container mt-5 info-strip p-4 text-center">
    <div class="row">
      <div class="col-6 col-md-3"><i class="bi bi-truck"></i><p class="fw-semibold mt-2">Free & Fast Delivery</p></div>
      <div class="col-6 col-md-3"><i class="bi bi-shield-check"></i><p class="fw-semibold mt-2">Secure Payments</p></div>
      <div class="col-6 col-md-3"><i class="bi bi-arrow-repeat"></i><p class="fw-semibold mt-2">Easy Returns</p></div>
      <div class="col-6 col-md-3"><i class="bi bi-headset"></i><p class="fw-semibold mt-2">24x7 Support</p></div>
    </div>
  </div>

  <!-- ===== FOOTER ===== -->
  <footer>
    <div class="container">
      <div class="row text-center text-md-start">
        <div class="col-md-3"><h6 class="footer-title">About</h6><a href="#">Contact Us</a><a href="#">About Us</a><a href="#">Careers</a></div>
        <div class="col-md-3"><h6 class="footer-title">Help</h6><a href="#">Payments</a><a href="#">Shipping</a><a href="#">Cancellation</a></div>
        <div class="col-md-3"><h6 class="footer-title">Policy</h6><a href="#">Return Policy</a><a href="#">Terms of Use</a><a href="#">Privacy</a></div>
        <div class="col-md-3"><h6 class="footer-title">Subscribe</h6><input type="email" placeholder="Enter email" class="form-control mb-2"><button class="btn btn-warning w-100">Subscribe</button></div>
      </div>
      <hr class="my-4" />
      <div class="text-center payments">
        <img src="https://img.icons8.com/color/48/visa.png">
        <img src="https://img.icons8.com/color/48/mastercard.png">
        <img src="https://img.icons8.com/color/48/paypal.png">
        <img src="https://img.icons8.com/color/48/google-pay.png">
      </div>
      <p class="text-center mt-3 mb-0">© 2025 LookMe (Flipkart Clone) | Designed by Sanjay</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
