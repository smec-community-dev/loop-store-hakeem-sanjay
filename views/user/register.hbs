<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Registration - ShopHub</title>
    <link rel="stylesheet" href="/user/register.css">
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="navbar-brand">
                <a href="/" class="logo">Loopstore</a>
            </div>
        </div>
    </nav>

    <!-- Register Section -->
    <main class="auth-section">
        <div class="auth-container">

            <!-- Register Card -->
            <div class="auth-card">

                <h1 class="auth-heading">Create Account</h1>
                <p class="auth-subtitle">Join ShopHub to start your journey</p>

                <form method="post" class="auth-form">

                    <div class="form-group">
                        <label>Full Name</label>
                        <input type="text" name="firstname" placeholder="John Doe" required>
                    </div>

                    <div class="form-group">
                        <label>Email Address</label>
                        <input type="email" name="email" placeholder="you@example.com" required>
                    </div>

                    <div class="form-group">
                        <label>Phone Number</label>
                        <input type="tel" name="phone" placeholder="9876543210" required>
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" name="password" placeholder="Enter your password" required>
                    </div>

                    <button type="submit" class="btn btn-primary btn-full">Create Account</button>

                    <p class="auth-bottom-text">
                        Already have an account?
                        <a href="/login">Login</a>
                    </p>

                </form>
            </div>

            <!-- Right Side Illustration -->
            <div class="auth-image">
                <div class="auth-illustration">
                    <div class="illustration-circle"></div>
                    <h2>Welcome to ShopHub</h2>
                    <p>Your new shopping experience starts here</p>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2025 ShopHub. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>
