<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Place Order - LookMe</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link rel="stylesheet" href="/user/order.css">
</head>

<body>

  <!-- NAVBAR -->
   <nav class="navbar navbar-expand-lg main-nav">
    <div class="container">

      <a href="/" class="logo">
    <i class="bi bi-bag-fill"></i>
    <span>LoopStore</span>
</a>



      <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
        <i class="bi bi-list"></i>
      </button>

      <div class="collapse navbar-collapse" id="mainNavbar">
        <ul class="navbar-nav ms-auto">

          <li class="nav-item">
  <a class="nav-link" href="/">
    <i class="bi bi-house-door"></i> Home
  </a>
</li>



          <li class="nav-item">
            <a class="nav-link" href="/allproducts">
              <i class="bi bi-grid"></i> Products
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/profile">
              <i class="bi bi-person"></i> Profile
            </a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/cart">
              <i class="bi bi-cart3"></i>
            </a>
          </li>

        </ul>
      </div>

    </div>
  </nav>

  <div class="container checkout-container">
    <div class="row">

      <!-- LEFT SIDE -->
      <div class="col-lg-8">

        <!-- ADDRESS SECTION -->
        <div class="section-box">
          <h5 class="section-title"><i class="bi bi-geo-alt"></i> Delivery Address</h5>

          <!-- SHOW SAVED ADDRESS -->
          <div id="addressView" style="display: {{#if address}} block {{else}} none {{/if}};">
            {{#if address}}
            <p><strong>{{address.address.name}}</strong></p>
            <p>{{address.address.house}}, {{address.address.street}}, {{address.address.city}},
              {{address.address.state}} - {{address.address.pincode}}</p>
            <p>Mobile: {{address.address.phone}}</p>

            <button class="btn btn-outline-primary btn-sm" onclick="editAddress()">
              <i class="bi bi-pencil"></i> Edit
            </button>
            {{/if}}
          </div>

          <!-- ADD / EDIT ADDRESS FORM -->
          <form method="POST" action="/order/{{data._id}}">
            <div id="addressEdit" style="display: {{#if address}} none {{else}} block {{/if}};">
              <div class="row">

                <div class="col-md-6 mb-2">
                  <label class="form-label">Full Name</label>
                  <input type="text" class="form-control" name="address[name]" value="{{address.address.name}}">
                </div>

                <div class="col-md-6 mb-2">
                  <label class="form-label">Phone</label>
                  <input type="text" class="form-control" name="address[phone]" value="{{address.address.phone}}">
                </div>

                <div class="col-md-6 mb-2">
                  <label class="form-label">House</label>
                  <input type="text" class="form-control" name="address[house]" value="{{address.address.house}}">
                </div>

                <div class="col-md-6 mb-2">
                  <label class="form-label">Street</label>
                  <input type="text" class="form-control" name="address[street]" value="{{address.address.street}}">
                </div>

                <div class="col-md-4 mb-2">
                  <label class="form-label">City</label>
                  <input type="text" class="form-control" name="address[city]" value="{{address.address.city}}">
                </div>

                <div class="col-md-4 mb-2">
                  <label class="form-label">State</label>
                  <input type="text" class="form-control" name="address[state]" value="{{address.address.state}}">
                </div>

                <div class="col-md-4 mb-2">
                  <label class="form-label">Pincode</label>
                  <input type="text" class="form-control" name="address[pincode]" value="{{address.address.pincode}}">
                </div>

              </div>

              <button type="submit" class="btn btn-primary btn-sm mt-2">Save Address</button>
            </div>
          </form>
        </div>

        <!-- ORDER SUMMARY -->
        <!-- ORDER SUMMARY -->
<div class="section-box">
    <h5 class="section-title"><i class="bi bi-bag-check"></i> Order Summary</h5>
    <div class="product-item">
        <img src="{{data.images.[0]}}" alt="product image" />

        <div class="product-details">
            <!-- Product Name -->
            <p class="product-name">{{data.name}}</p>
            
            <!-- Product Category -->
            {{#if data.category}}
            <span class="product-category">{{data.category.name}}</span>
            {{/if}}
            
            <!-- Product Description -->
            {{#if data.description}}
            <p class="product-description">{{data.description}}</p>
            {{/if}}

            <!-- Product Price -->
            <p class="product-price">₹{{data.price}}</p>

            <!-- Stock Information -->
            <div class="stock-info">
                {{#if data.stock}}
                    {{#gt data.stock 10}}
                    <span class="in-stock"><i class="bi bi-check-circle"></i> In Stock</span>
                    {{else}}
                    {{#gt data.stock 0}}
                    <span class="low-stock"><i class="bi bi-exclamation-triangle"></i> Only {{data.stock}} left</span>
                    {{else}}
                    <span class="out-of-stock"><i class="bi bi-x-circle"></i> Out of Stock</span>
                    {{/gt}}
                    {{/gt}}
                {{/if}}
            </div>

            <!-- QUANTITY SELECTOR -->
            <div class="quantity-selector">
                <button type="button" class="qty-btn" data-action="decrease">−</button>
                <span id="qty" class="qty-display" data-stock="{{data.stock}}" data-price="{{data.price}}">1</span>
                <button type="button" class="qty-btn" data-action="increase">+</button>
            </div>
        </div>
    </div>
    <p class="summary-total">Total: ₹<span id="total">{{data.price}}</span></p>
</div>
      </div>

      <!-- RIGHT SIDE -->
      <div class="col-lg-4">

        <div class="section-box">
          <h5 class="section-title"><i class="bi bi-receipt"></i> Price Details</h5>
          <p>Price: ₹<span id="sidePrice">{{data.price}}</span></p>
          <p>Delivery: Free</p>
          <hr>
          <h6>Total Payable: ₹<span id="sideTotal">{{data.price}}</span></h6>
        </div>
    
        <!-- PLACE ORDER BUTTON -->
        {{#if address}}
        <div class="text-center mt-3">
          <a id="placeOrderLink" class="btn-place-order" href="#">
            <i class="bi bi-check-circle"></i> Place Order
          </a>
        </div>
        {{else}}
        <div class="text-center mt-3">
          <button onclick="editAddress()" class="btn-place-order"
            style="opacity:0.5; cursor:not-allowed; background:#ccc;">
            <i class="bi bi-x-circle"></i> Add Address to Continue
          </button>
        </div>
        {{/if}}

      </div>

    </div>
  </div>

  <footer class="text-center">
    <p>© 2025 LoopStore. All rights reserved.</p>
  </footer>

  <!-- CLEAN FINAL SCRIPT -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {

      const qtySpan = document.getElementById("qty");
      const maxStock = parseInt(qtySpan.getAttribute("data-stock"));
      const price = parseInt(qtySpan.getAttribute("data-price"));

      let qty = 1;

      const totalEl = document.getElementById("total");
      const sidePrice = document.getElementById("sidePrice");
      const sideTotal = document.getElementById("sideTotal");

      function updatePrices() {
        let total = price * qty;
        qtySpan.textContent = qty;
        totalEl.textContent = total;
        sidePrice.textContent = total;
        sideTotal.textContent = total;
      }

      // Quantity Buttons
      document.querySelectorAll(".qty-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const action = btn.getAttribute("data-action");

          if (action === "increase" && qty < maxStock) qty++;
          if (action === "decrease" && qty > 1) qty--;

          updatePrices();
        });
      });

      // Place Order
      const orderBtn = document.getElementById("placeOrderLink");
      if (orderBtn) {
        orderBtn.addEventListener("click", (e) => {
          e.preventDefault();
          const id = "{{data._id}}";
          window.location.href = `/placeorder/${id}?qty=${qty}`;
        });
      }

      updatePrices();
    });

    function editAddress() {
      document.getElementById("addressView").style.display = "none";
      document.getElementById("addressEdit").style.display = "block";
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  </script>

</body>

</html>
