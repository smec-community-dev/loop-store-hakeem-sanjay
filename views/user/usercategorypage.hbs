<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{data.category}} - LoopStore</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="user/usercategorypage.css">
</head>

<body>



<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg main-nav">
  <div class="container">

    <!-- LOGO -->
    <a class="navbar-brand fw-bold" href="/">
      <i class="bi bi-bag-fill logo-icon"></i>
      <span class="logo-text">Loop</span><span class="logo-yellow">Store</span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navMenu">

      <!-- SEARCH BAR -->
      <form class="search-bar mx-auto" method="POST" action="/">
        <input name="search" class="form-control" type="text" placeholder="Search for products...">
        <button class="btn"><i class="bi bi-search"></i></button>
      </form>

      <!-- RIGHT LINKS -->
      <ul class="navbar-nav ms-auto">
        <!-- Products Dropdown -->
         <li class="nav-item">
  <a class="nav-link" href="/allproducts">
    <i class="bi bi-grid"></i> Products
  </a>
</li>


      

        <li class="nav-item">
          <a class="nav-link" href="/contact"><i class="bi bi-envelope"></i> Contact</a>
        </li>

         <li class="nav-item">
          <a class="nav-link" href="/profile"><i class="bi bi-person"></i> Profile</a>
        </li>
    

        <li class="nav-item">
          <a class="nav-link" href="/cart"><i class="bi bi-cart3"></i></a>
        </li>

      </ul>

    </div>
  </div>
</nav>

<!-- ================= HEADER INFO STRIP ================= -->
<div class="header-info">
  <div class="container-fluid">
    <div class="row">

      <div class="col-md-4">
        <div class="header-item">
          <i class="bi bi-truck" style="font-size: 1.5rem; color: #ff9f00;"></i>
          <p>Free shipping on orders over $30 in USA</p>
        </div>
      </div>

      <div class="col-md-4 text-center">
        <div class="header-item">
          <i class="bi bi-tag" style="font-size: 1.5rem; color: #ff9f00;"></i>
          <p>20% Student Discount</p>
        </div>
      </div>

      <div class="col-md-4 text-end">
        <div class="header-item">
          <i class="bi bi-percent" style="font-size: 1.5rem; color: #ff9f00;"></i>
          <p>30% off on dresses – Use code: 30OFF</p>
        </div>
      </div>

    </div>
  </div>
</div>


<!-- MAIN CONTENT WITH FILTERS AND PRODUCTS -->
<div class="container mt-4">
  <div class="row">
    
    <!-- FILTER SIDEBAR -->
    <div class="col-lg-3 d-none d-lg-block">
      <div class="filter-sidebar">

       <!-- START FORM -->
<form method="GET" action="/allproducts">

  <div class="filter-header">
    <h3 class="filter-title">Filters</h3>
    <button type="reset" class="filter-clear">Clear All</button>
  </div>

  <!-- PRICE FILTER -->
  <div class="filter-section">
    <h4 class="filter-section-title">Price Range</h4>

    <input 
      type="range"
      class="price-range"
      name="price"
      min="0"
      max="100000"
      value="{{price}}"
    >

    <div class="price-value">
      <span id="priceCurrent">{{price}}</span> / <span id="priceMax">100000</span>
    </div>
  </div>

  <!-- BRAND FILTER -->
  <div class="filter-section">
    <h4 class="filter-section-title">Brand</h4>

    <ul class="filter-options">
      {{#each categories}}
      <li>
        <input 
          type="checkbox" 
          name="brand" 
          value="{{this._id}}" 
          id="brand_{{@index}}"

          {{#if (eq ../brand this._id)}}checked{{/if}}
        >
        <label for="brand_{{@index}}">{{this.name}}</label>
      </li>
      {{/each}}
    </ul>
  </div>

  <button type="submit" class="apply-filters">Apply Filters</button>
</form>

<!-- END FORM -->
</div>
    </div> 

<!-- PRODUCTS GRID -->
<div class="col-lg-9">
  <div class="row g-4">

    {{#each data}}
    <div class="col-6 col-md-4 col-lg-4 fade-in">
      <div class="product-card">

        <div class="img-box">
          <img src="{{this.images.[0]}}" class="product-img">
        </div>

        <h6 class="product-title">{{this.name}}</h6>

        <p class="category-text">{{this.category.name}}</p>

        <div class="price-wrap">
          <span class="new-price">₹{{this.price}}</span>
        </div>

        <a href="/singlepage/{{this._id}}" class="view-btn">View Details</a>

      </div>
    </div>
    {{/each}}

  </div>
</div>


      <!-- PAGINATION -->
<div class="pagination-wrapper">
  <ul class="pagination">

    <!-- Previous Button -->
    <li class="page-item {{#unless prevPage}}disabled{{/unless}}">
      <a class="page-link" 
         href="?page={{prevPage}}&price={{price}}{{#if brand}}{{#each (arrayify brand)}}&brand={{this}}{{/each}}{{/if}}">
        Previous
      </a>
    </li>

    <!-- Page Numbers -->
    {{#each pages}}
      <li class="page-item {{#if (eq this ../page)}}active{{/if}}">
        <a 
          class="page-link" 
          href="?page={{this}}&price={{../price}}{{#if ../brand}}{{#each (arrayify ../brand)}}&brand={{this}}{{/each}}{{/if}}">
          {{this}}
        </a>
      </li>
    {{/each}}

    <!-- Next Button -->
    <li class="page-item {{#unless nextPage}}disabled{{/unless}}">
      <a class="page-link" 
         href="?page={{nextPage}}&price={{price}}{{#if brand}}{{#each (arrayify brand)}}&brand={{this}}{{/each}}{{/if}}">
        Next
      </a>
    </li>

  </ul>
</div>


    </div>
  </div>
</div>

<!-- MOBILE FILTER MODAL -->
<div class="mobile-filter-modal" id="mobileFilterModal">
  <div class="mobile-filter-content">
    <button class="close-filter" id="closeFilterModal">
      <i class="bi bi-x-lg"></i>
    </button>
    
    <div class="filter-header mt-4">
      <h3 class="filter-title">Filters</h3>
      <button class="filter-clear">Clear All</button>
    </div>

    <!-- Mobile filter content would go here (same as desktop filters) -->
    
    <div class="filter-section">
      <h4 class="filter-section-title">Price Range</h4>
      <input type="range" class="price-range" min="0" max="100000" value="50000">
      <div class="price-inputs">
        <input type="number" placeholder="Min" value="0">
        <input type="number" placeholder="Max" value="100000">
      </div>
    </div>

    <button class="apply-filters">Apply Filters</button>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Navbar scroll effect
  window.addEventListener('scroll', function() {
    const navbar = document.querySelector('.main-nav');
    if (window.scrollY > 100) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  });

  // Scroll animations
  document.addEventListener('DOMContentLoaded', function() {
    const fadeElements = document.querySelectorAll('.fade-in');
    
    const fadeInOnScroll = function() {
      fadeElements.forEach(element => {
        const elementTop = element.getBoundingClientRect().top;
        const elementVisible = 150;
        
        if (elementTop < window.innerHeight - elementVisible) {
          element.classList.add('visible');
        }
      });
    };
    
    // Check on load
    fadeInOnScroll();
    
    // Check on scroll
    window.addEventListener('scroll', fadeInOnScroll);
  });

  // Mobile filter toggle
  document.addEventListener('DOMContentLoaded', function() {
    const filterToggle = document.getElementById('mobileFilterToggle');
    const filterModal = document.getElementById('mobileFilterModal');
    const closeFilter = document.getElementById('closeFilterModal');
    
    if (filterToggle && filterModal) {
      filterToggle.addEventListener('click', function() {
        filterModal.style.display = 'block';
      });
      
      closeFilter.addEventListener('click', function() {
        filterModal.style.display = 'none';
      });
      
      // Close modal when clicking outside
      filterModal.addEventListener('click', function(e) {
        if (e.target === filterModal) {
          filterModal.style.display = 'none';
        }
      });
    }
  });
  {{!-- PRICE RANGE SCRIPT --}}
  const priceRange = document.querySelector('.price-range');
  const priceCurrent = document.getElementById('priceCurrent');

  // Set initial value on page load
  priceCurrent.textContent = priceRange.value;

  // Update live when sliding
  priceRange.addEventListener('input', function () {
    priceCurrent.textContent = this.value;
  });
</script>

</body>
</html>