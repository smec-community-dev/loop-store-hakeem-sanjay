<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{data.category}} - LoopStore</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  
  <link rel="stylesheet" href="/user/usercategorypage.css">
</head>

<body>

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg main-nav shadow-sm">
  <div class="container">

    <!-- LOGO -->
    <a class="navbar-brand fw-bold" href="/">
      <i class="bi bi-bag-fill logo-icon"></i>
      <span class="logo-text">Loop</span><span class="logo-yellow">Store</span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navMenu">

      <!-- SEARCH BAR -->
      <form class="search-bar d-flex mx-auto" method="POST" action="/">
        <input name="search" class="form-control" type="text" placeholder="Search for products...">
        <button class="btn"><i class="bi bi-search"></i></button>
      </form>

      <!-- RIGHT LINKS -->
      <ul class="navbar-nav ms-auto">

        {{#if user}}
        <li class="nav-item">
          <a class="nav-link" href="/profile">
            <i class="bi bi-person-circle"></i> {{user.name}}
          </a>
        </li>
        {{else}}
        <li class="nav-item">
          <a class="nav-link" href="/profile"><i class="bi bi-person-circle"></i> Profile</a>
        </li>
        {{/if}}

        <li class="nav-item">
          <a class="nav-link" href="/cart"><i class="bi bi-cart3"></i></a>
        </li>

      </ul>

    </div>
  </div>
</nav>

<!-- CATEGORY TITLE -->
<div class="container mt-4">
  <h2 class="fw-bold text-capitalize">{{data.category}}</h2>
  <hr>
</div>

<!-- PRODUCTS GRID -->
<div class="container mt-4">
  <div class="row g-4">

    {{#each data}}
    <div class="col-6 col-md-4 col-lg-3">
      <div class="product-card">

        <div class="img-box">
          <img src="/uploads/{{this.images.[0]}}" class="product-img">

          {{#if this.isNew}}
          <span class="badge-new">NEW</span>
          {{/if}}

          {{#if this.isSale}}
          <span class="badge-sale">SALE</span>
          {{/if}}
        </div>

        <h6 class="product-title">{{this.name}}</h6>

        <p class="category-text">{{this.category.name}}</p>

        <div class="price-wrap">
          {{#if this.oldPrice}}
          <span class="old-price">₹{{this.oldPrice}}</span>
          {{/if}}
          <span class="new-price">₹{{this.price}}</span>
        </div>

        <a href="/singlepage/{{this._id}}" class="view-btn">View Details</a>

      </div>
    </div>
    {{/each}}

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
