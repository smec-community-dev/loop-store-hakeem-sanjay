<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile - ShopHub</title>
    <link rel="stylesheet" href="userprofile.css">
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="container">
            <div class="navbar-brand">
                <a href="/" class="logo">ShopHub</a>
            </div>

            <ul class="nav-links">
                <li><a href="/">Home</a></li>

                <li>
                    <a href="/cart" class="cart-icon">
                        <span class="icon">🛒</span>
                        <span class="badge">3</span>
                    </a>
                </li>

                <li><a href="/logout" class="btn btn-secondary btn-sm">Logout</a></li>
            </ul>
        </div>
    </nav>

    <!-- PROFILE SECTION -->
    <main class="profile-section">
        <div class="container">
            <div class="profile-wrapper">

                <!-- SIDEBAR -->
                <aside class="profile-sidebar">
                    <div class="profile-card">
                        <div class="profile-avatar">
                            {{data.firstname}}
                        </div>

                        <h2>{{data.firstname}}</h2>
                        <p class="profile-status">{{data.email}}</p>

                        <div class="profile-stats">
                            <div class="stat">
                                <span class="stat-value">12</span>
                                <span class="stat-label">Orders</span>
                            </div>
                            <div class="stat">
                                <span class="stat-value">$450</span>
                                <span class="stat-label">Spent</span>
                            </div>
                        </div>
                    </div>

                    <nav class="profile-nav">
                        <ul>
                            <li><a href="#profile" class="nav-link active">👤 Profile</a></li>
                            <li><a href="#orders" class="nav-link">📦 Orders</a></li>
                            <li><a href="#wishlist" class="nav-link">❤️ Wishlist</a></li>
                            <li><a href="#editProfile" class="nav-link">✏️ Edit Profile</a></li>
                        </ul>
                    </nav>
                </aside>

                <!-- MAIN CONTENT -->
                <section class="profile-content">

                    <!-- PROFILE TAB -->
                    <div class="profile-tab active" id="profile">
                        <h2>Personal Information</h2>

                        <form class="profile-form">

                            <div class="form-group">
                                <label>First Name</label>
                                <input type="text" value="{{data.firstname}}" readonly>
                            </div>

                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" value="{{data.email}}" readonly>
                            </div>

                            <div class="form-group">
                                <label>Phone</label>
                                <input type="text" value="{{data.phone}}" readonly>
                            </div>

                            <a href="#editProfile" class="btn btn-primary">Edit Profile</a>
                        </form>
                    </div>

                    <!-- ORDERS TAB -->
                    <div class="profile-tab" id="orders">
                        <h2>Recent Orders</h2>

                        <div class="orders-list">

                            <div class="order-card">
                                <div class="order-header">
                                    <h3>Order #12345</h3>
                                    <span class="order-status status-delivered">Delivered</span>
                                </div>

                                <div class="order-details">
                                    <p><strong>Date:</strong> Jan 10, 2025</p>
                                    <p><strong>Items:</strong> 3</p>
                                    <p><strong>Total:</strong> $125.99</p>
                                </div>

                                <div class="order-actions">
                                    <button class="btn btn-secondary btn-sm">View Details</button>
                                    <button class="btn btn-primary btn-sm">Reorder</button>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- WISHLIST TAB -->
                    <div class="profile-tab" id="wishlist">
                        <h2>My Wishlist</h2>

                        <div class="products-grid">
                            <div class="product-card">
                                <div class="product-image">💻</div>
                                <h3>Laptop Pro</h3>
                                <p class="product-price">$999</p>
                                <div class="product-actions">
                                    <button class="btn btn-primary btn-sm">Add to Cart</button>
                                    <button class="btn btn-danger btn-sm">Remove</button>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- EDIT PROFILE TAB -->
                    <div class="profile-tab" id="editProfile">
                        <h2>Edit Profile</h2>

                        <form class="profile-form" method="POST">

                            <div class="form-group">
                                <label>First Name</label>
                                <input type="text" name="firstname" value="{{data.firstname}}" required>
                            </div>

                            <div class="form-group">
                                <label>Email Address</label>
                                <input type="email" name="email" value="{{data.email}}" required>
                            </div>

                            <div class="form-group">
                                <label>Phone Number</label>
                                <input type="text" name="phone" value="{{data.phone}}">
                            </div>

                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <a href="#profile" class="btn btn-secondary" style="margin-left:10px;">Cancel</a>

                        </form>
                    </div>

                </section>

            </div>
        </div>
    </main>

    <footer class="footer">
        <p>© 2025 ShopHub. All rights reserved.</p>
    </footer>

    <script>
        // Sidebar Tab Switching
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();

                document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
                document.querySelectorAll('.profile-tab').forEach(tab => tab.classList.remove('active'));

                link.classList.add('active');
                const target = document.querySelector(link.getAttribute('href'));
                target.classList.add('active');
            });
        });
    </script>

</body>
</html>
