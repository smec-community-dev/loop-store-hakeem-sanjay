<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LoopStore – Home</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/user/homepage.css">
</head>

<body>

<!-- ================= TOP HEADER ================= -->
<div class="top-header">
  <div class="container d-flex justify-content-between">
    <p>Help / Support / Contact</p>
    <p>Call Us: (+91) 98765 43210</p>
  </div>
</div>

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg main-nav">
  <div class="container">

    <a class="navbar-brand" href="/">
      <i class="bi bi-bag-fill logo-icon"></i>
      <span class="logo-text">LoopStore</span>
    </a>

    <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navMenu">

      <form method="POST" action="/" class="search-bar mx-auto">
        <input name="search" type="text" placeholder="Search for Products, Brands and More">
        <button><i class="bi bi-search"></i></button>
      </form>

      <ul class="navbar-nav ms-auto">

        {{#if user}}
          <li class="nav-item">
            <a class="nav-link" href="/profile">
              <i class="bi bi-person"></i> Profile
            </a>
          </li>
        {{else}}
          <li class="nav-item">
            <a class="nav-link" href="/login"><i class="bi bi-person"></i> Login</a>
          </li>
        {{/if}}

        <li class="nav-item">
          <a class="nav-link" href="/cart"><i class="bi bi-cart3"></i></a>
        </li>

      </ul>

    </div>
  </div>
</nav>

<!-- ================= HEADER INFO STRIP ================= -->
<div class="header-info">
  <div class="container-fluid">
    <div class="row">

      <div class="col-md-4">
        <div class="header-item">
          <img src="/uploads/delivery.png" alt="">
          <p>Free shipping on orders over $30 in USA</p>
        </div>
      </div>

      <div class="col-md-4 text-center">
        <div class="header-item">
          <img src="/uploads/voucher.png" alt="">
          <p>20% Student Discount</p>
        </div>
      </div>

      <div class="col-md-4 text-end">
        <div class="header-item">
          <img src="/uploads/sales.png" alt="">
          <p>30% off on dresses – Use code: 30OFF</p>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- ================= HERO SLIDER (OWL) ================= -->
<section class="hero-slider">

  <div class="single-slider-item hero-bg">
      <div class="container">
        <h1>Since 2000</h1>
        <h2>Loopstore.</h2>
        <a href="#" class="primary-btn">See More</a>
      </div>
  </div>

</section>



<!-- ================= FEATURES SECTION ================= -->
<section class="features-section spad">
  <div class="features-ads">
    <div class="container">

      <div class="row">

        <div class="col-lg-4">
          <div class="single-features-ads">
            <img src="/uploads/f-delivery.png">
            <h4>Free Shipping</h4>
            <p>Fast delivery right to your doorstep.</p>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="single-features-ads">
            <img src="/uploads/coin.png">
            <h4>100% Money Back</h4>
            <p>Return & refund without questions.</p>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="single-features-ads">
            <img src="/uploads/chat.png">
            <h4>24/7 Support</h4>
            <p>Our team is here anytime you need.</p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- ================= CATEGORY GRID ================= -->
<div class="container mt-4">
  <h4 class="section-heading">Shop By Categories</h4>

  <div class="row g-3">
    {{#each categories}}
      <div class="col-6 col-md-3 col-lg-2">
        <a href="/usercategorypage?cat={{this.name}}" class="category-box">
          <img src="/uploads/{{this.image}}" alt="{{this.name}}">
          <p>{{this.name}}</p>
        </a>
      </div>
    {{/each}}
  </div>
</div>

<!-- ================= BOOTSTRAP HERO SLIDER ================= -->
<div class="container mt-4">
  <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">

    <div class="carousel-inner">
      <div class="carousel-item active">
        <img src="/uploads/web site banner.jpg" class="d-block w-100">
      </div>

      <div class="carousel-item">
        <img src="/uploads/Motorola Edge.jpg" class="d-block w-100">
      </div>

      <div class="carousel-item">
        <img src="/uploads/Huawei FreeBuds.jpg" class="d-block w-100">
      </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon"></span>
    </button>

  </div>
</div>

<!-- ================= TOP OFFERS ================= -->
<div class="container mt-5">
  <h4 class="section-heading">Top Offers</h4>

  <div class="row g-4">

    {{#each topOffers}}
      <div class="col-6 col-md-4 col-lg-3">

        <a href="/singlepage/{{this._id}}" class="product-link">

          <div class="product-box">

            {{#if this.isNew}} 
              <span class="badge-new">New</span> 
            {{/if}}

            {{#if this.isSale}} 
              <span class="badge-sale">Sale</span> 
            {{/if}}

            <img src="/uploads/{{this.images.[0]}}" class="product-img">

            <p class="category-text">{{this.category.name}}</p>
            <h6 class="product-title">{{this.name}}</h6>

            <div class="price-wrap">
              {{#if this.oldPrice}}
                <span class="old-price">₹{{this.oldPrice}}</span>
              {{/if}}

              <span class="new-price">₹{{this.price}}</span>
            </div>

          </div>

        </a>

      </div>
    {{/each}}

  </div>
</div>


<!-- ================= TOP PICKS ================= -->
<div class="container mt-5">
  <h4 class="section-heading">Top Picks of the Sale</h4>

  <div class="row g-4">

    {{#each topPicks}}
      <div class="col-6 col-md-4 col-lg-3">

        <a href="/singlepage/{{this._id}}" class="product-link">

          <div class="product-box">

            <img src="/uploads/{{this.images.[0]}}" class="product-img">
            <p class="category-text">{{this.category.name}}</p>
            <h6 class="product-title">{{this.name}}</h6>

            <div class="price-wrap">
              <span class="new-price">₹{{this.price}}</span>
            </div>

          </div>

        </a>

      </div>
    {{/each}}

  </div>
</div>

<!-- ================= DEALS OF THE DAY ================= -->
<div class="container mt-5">
  <h4 class="section-heading">Deals of the Day</h4>

  <div class="row g-4">

    {{#each dealsOfDay}}
      <div class="col-6 col-md-4 col-lg-3">

        <a href="/singlepage/{{this._id}}" class="product-link">

          <div class="product-box">

            <img src="/uploads/{{this.images.[0]}}" class="product-img">
            <p class="category-text">{{this.category.name}}</p>
            <h6 class="product-title">{{this.name}}</h6>

            <div class="price-wrap">
              <span class="new-price">₹{{this.price}}</span>
            </div>

          </div>

        </a>

      </div>
    {{/each}}

  </div>
</div>


<!-- ================= INFO STRIP ================= -->
<div class="container mt-5">
  <div class="row info-strip">

    <div class="col-6 col-md-3 text-center">
      <i class="bi bi-truck"></i>
      <p>Fast Delivery</p>
    </div>

    <div class="col-6 col-md-3 text-center">
      <i class="bi bi-shield-check"></i>
      <p>Secure Payment</p>
    </div>

    <div class="col-6 col-md-3 text-center">
      <i class="bi bi-arrow-repeat"></i>
      <p>Easy Returns</p>
    </div>

    <div class="col-6 col-md-3 text-center">
      <i class="bi bi-headset"></i>
      <p>24x7 Support</p>
    </div>

  </div>
</div>

<!-- ================= FOOTER ================= -->
<footer class="footer mt-5">

  <div class="container">

    <div class="row">

      <div class="col-md-3">
        <h5 class="footer-title">LoopStore</h5>
        <p>Your one-stop shop for electronics, fashion & accessories.</p>

        <div class="social-icons">
          <a href="#"><i class="bi bi-facebook"></i></a>
          <a href="#"><i class="bi bi-instagram"></i></a>
          <a href="#"><i class="bi bi-twitter"></i></a>
        </div>
      </div>

      <div class="col-md-3">
        <h5 class="footer-title">Customer Service</h5>
        <ul class="footer-links">
          <li><a href="#">Contact</a></li>
          <li><a href="#">Refund Policy</a></li>
          <li><a href="#">Track Order</a></li>
        </ul>
      </div>

      <div class="col-md-3">
        <h5 class="footer-title">Categories</h5>
        <ul class="footer-links">
          <li><a href="#">Mobiles</a></li>
          <li><a href="#">Fashion</a></li>
          <li><a href="#">Electronics</a></li>
        </ul>
      </div>

      <div class="col-md-3">
        <h5 class="footer-title">Contact</h5>
        <p><i class="bi bi-geo-alt"></i> Chennai, Tamil Nadu</p>
        <p><i class="bi bi-telephone"></i> +91 98765 43210</p>
        <p><i class="bi bi-envelope"></i> support@loopstore.com</p>
      </div>

    </div>

    <hr>

    <div class="text-center copyright">
      © 2025 LoopStore – All Rights Reserved
    </div>

  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
