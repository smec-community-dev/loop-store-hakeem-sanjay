<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LoopStore – Home</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="user/homepage.css">
  
</head>

<body>

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg main-nav">
  <div class="container">

    <a class="navbar-brand" href="/">
      <i class="bi bi-bag-fill logo-icon"></i>
      <span class="logo-text">LoopStore</span>
    </a>

    <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navMenu">

      <form method="POST" action="/" class="search-bar mx-auto">
        <input name="search" type="text" placeholder="Search for Products, Brands and More">
        <button><i class="bi bi-search"></i></button>
      </form>

      <ul class="navbar-nav ms-auto">

        <!-- 🔥 PRODUCTS DROPDOWN ADDED -->
        <li class="nav-item dropdown">
         <li class="nav-item">
  <a class="nav-link" href="/allproducts">
    <i class="bi bi-grid"></i> Products
  </a>
</li>

       

        <li class="nav-item">
          <a class="nav-link" href="/contact"><i class="bi bi-envelope"></i> Contact</a>
        </li>

       

        <li class="nav-item">
          <a class="nav-link" href="/profile"><i class="bi bi-person"></i> Profile</a>
        </li>

        <li class="nav-item">
          <a class="nav-link" href="/cart"><i class="bi bi-cart3"></i></a>
        </li>

      </ul>

    </div>
  </div>
</nav>

<!-- ================= HEADER INFO STRIP ================= -->
<div class="header-info">
  <div class="container-fluid">
    <div class="row align-items-center">

      <div class="col-md-4">
        <div class="header-item d-flex align-items-center gap-2">
          <img src="https://img.icons8.com/ios-filled/50/000000/delivery.png" class="img-fluid" style="width: 28px;" alt="">
          <p class="mb-0">Free shipping on orders over $30 in USA</p>
        </div>
      </div>

      <div class="col-md-4 text-center">
        <div class="header-item d-flex justify-content-center align-items-center gap-2">
          <img src="https://img.icons8.com/ios-filled/50/000000/discount.png" class="img-fluid" style="width: 28px;" alt="">
          <p class="mb-0">20% Student Discount</p>
        </div>
      </div>

      <div class="col-md-4 text-end">
        <div class="header-item d-flex justify-content-end align-items-center gap-2">
          <img src="https://img.icons8.com/ios-filled/50/percentage.png" class="img-fluid" style="width: 28px;" alt="">
          <p class="mb-0">30% off on dresses – Use code: 30OFF</p>
        </div>
      </div>

    </div>
  </div>
</div>


<!-- ================= HERO SLIDER ================= -->
<section class="hero-slider">
  <div class="single-slider-item hero-bg">
    <div class="container">
      <h1>Since 2000</h1>
      <h2>Loopstore.</h2>
      <a href="/allproducts" class="primary-btn">See More</a>
    </div>
  </div>
</section>



<!-- ================= CATEGORY SLIDER ================= -->
<div class="container mt-4">
  <h4 class="section-heading">Shop By Categories</h4>

  <div class="category-slider-wrapper">

    <!-- Left Arrow -->
    <button class="cat-btn left-btn" id="catLeft">
      <i class="bi bi-chevron-left"></i>
    </button>

    <!-- Slider -->
    <div class="category-slider" id="catSlider">

      {{#each categories}}
      <div class="category-item">
        <img src="{{this.image}}" alt="{{this.name}}">
        <p>{{this.name}}</p>
      </div>
      {{/each}}

    </div>

    <!-- Right Arrow -->
    <button class="cat-btn right-btn" id="catRight">
      <i class="bi bi-chevron-right"></i>
    </button>

  </div>
</div>


    

<!-- ================= HERO CAROUSEL ================= -->
<div class="container-fluid px-0 hero-slider">
  <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">

    <div class="carousel-inner">

      <div class="carousel-item active">
        <div class="hero-slide" 
             style="background-image: url('https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=2000&q=80');">
        </div>
      </div>

      <div class="carousel-item">
        <div class="hero-slide"
             style="background-image: url('https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=2000&q=80');">
        </div>
      </div>

      <div class="carousel-item">
        <div class="hero-slide"
             style="background-image: url('https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1480&q=80');">
        </div>
      </div>

      <div class="carousel-item">
        <div class="hero-slide"
             style="background-image: url('https://images.unsplash.com/photo-1499951360447-b19be8fe80f5?ixlib=rb-4.0.3&auto=format&fit=crop&w=1350&q=80');">
        </div>
      </div>


    </div>

    <!-- Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon"></span>
    </button>

  </div>
</div>


<!-- ================= TOP OFFERS ================= -->
<div class="container mt-5">
  <h4 class="section-heading">Top Offers</h4>

  <div class="row g-4">


    {{#each topOffers}}
    <div class="col-6 col-md-4 col-lg-3 fade-in">
      <a href="/singlepage/{{this._id}}" class="product-link">
        <div class="product-box">
          <img src="{{this.images.[0]}}" class="product-img">
          <p class="category-text">{{this.category.name}}</p>
          <h6 class="product-title">{{this.name}}</h6>
          <div class="price-wrap">
            <span class="new-price">₹{{this.price}}</span>
          </div>
        </div>
      </a>
    </div>
    {{/each}}

  </div>
</div>

<!-- ================= TOP PICKS ================= -->
<div class="container mt-5">
  <h4 class="section-heading">Top Picks of the Sale</h4>

  <div class="row g-4">
    {{#each topPicks}}
    <div class="col-6 col-md-4 col-lg-3 fade-in">
      <a href="/singlepage/{{this._id}}" class="product-link">
        <div class="product-box">
          <img src="{{this.images.[0]}}" class="product-img">
          <p class="category-text">{{this.category.name}}</p>
          <h6 class="product-title">{{this.name}}</h6>
          <div class="price-wrap">
            <span class="new-price">₹1{{this.price}}</span>
          </div>
        </div>
      </a>
    </div>
    {{/each}}
  </div>
</div>

<!-- ================= DEALS OF THE DAY ================= -->
<div class="container mt-5">
  <h4 class="section-heading">Deals of the Day</h4>

  <div class="row g-4">
    {{#each dealsOfDay}}
    <div class="col-6 col-md-4 col-lg-3 fade-in">
      <a href="/singlepage/{{this._id}}" class="product-link">
        <div class="product-box">
          <img src="{{this.images.[0]}}" class="product-img">
          <p class="category-text">{{this.category.name}}</p>
          <h6 class="product-title">{{this.name}}</h6>
          <div class="price-wrap">
            <span class="new-price">₹{{this.price}}</span>
          </div>
        </div>
      </a>
    </div>
    {{/each}}
  </div>
</div>

<!-- ================= INFO STRIP ================= -->
<div class="container mt-5">
  <div class="row info-strip">

    <div class="col-6 col-md-3 text-center fade-in">
      <i class="bi bi-truck"></i>
      <p>Fast Delivery</p>
    </div>

    <div class="col-6 col-md-3 text-center fade-in">
      <i class="bi bi-shield-check"></i>
      <p>Secure Payment</p>
    </div>

    <div class="col-6 col-md-3 text-center fade-in">
      <i class="bi bi-arrow-repeat"></i>
      <p>Easy Returns</p>
    </div>

    <div class="col-6 col-md-3 text-center fade-in">
      <i class="bi bi-headset"></i>
      <p>24x7 Support</p>
    </div>

  </div>
</div>

<!-- ================= FOOTER ================= -->
<footer class="footer mt-5">

  <div class="container">

    <div class="row">

      <div class="col-md-3">
        <h5 class="footer-title">LoopStore</h5>
        <p>Your one-stop shop for electronics, fashion & accessories.</p>

        <div class="social-icons">
          <a href="#"><i class="bi bi-facebook"></i></a>
          <a href="#"><i class="bi bi-instagram"></i></a>
          <a href="#"><i class="bi bi-twitter"></i></a>
        </div>
      </div>

      <div class="col-md-3">
        <h5 class="footer-title">Customer Service</h5>
        <ul class="footer-links">
          <li><a href="/contact">Contact</a></li>
          <li><a href="#">Refund Policy</a></li>
          <li><a href="#">Track Order</a></li>
        </ul>
      </div>

      <div class="col-md-3">
        <h5 class="footer-title">Categories</h5>
        <ul class="footer-links">
          <li><a href="/usercategorypage?cat=Electronics">Electronics</a></li>
          <li><a href="/usercategorypage?cat=Fashion">Fashion</a></li>
          <li><a href="/usercategorypage?cat=Home & Kitchen">Home & Kitchen</a></li>
        </ul>
      </div>

      <div class="col-md-3">
        <h5 class="footer-title">Contact</h5>
        <p><i class="bi bi-geo-alt"></i> Chennai, Tamil Nadu</p>
        <p><i class="bi bi-telephone"></i> +91 98765 43210</p>
        <p><i class="bi bi-envelope"></i> support@loopstore.com</p>
      </div>

    </div>

    <hr>

    <div class="text-center copyright">
      © 2025 LoopStore – All Rights Reserved
    </div>

  </div>
</footer>

<!-- Scroll to top button -->
<div class="scroll-to-top">
  <i class="bi bi-arrow-up"></i>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
// ================= CATEGORY SLIDER JS =================
document.addEventListener("DOMContentLoaded", () => {
    const slider = document.getElementById("catSlider");
    const leftBtn = document.getElementById("catLeft");
    const rightBtn = document.getElementById("catRight");

    const scrollAmount = 250;

    rightBtn.addEventListener("click", () => {
        slider.scrollBy({
            left: scrollAmount,
            behavior: "smooth",
        });
    });

    leftBtn.addEventListener("click", () => {
        slider.scrollBy({
            left: -scrollAmount,
            behavior: "smooth",
        });
    });
});


  // Navbar scroll effect
  window.addEventListener('scroll', function() {
    const navbar = document.querySelector('.main-nav');
    if (window.scrollY > 100) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  });

  // Scroll animations
  document.addEventListener('DOMContentLoaded', function() {
    const fadeElements = document.querySelectorAll('.fade-in');
    
    const fadeInOnScroll = function() {
      fadeElements.forEach(element => {
        const elementTop = element.getBoundingClientRect().top;
        const elementVisible = 150;
        
        if (elementTop < window.innerHeight - elementVisible) {
          element.classList.add('visible');
        }
      });
    };
    
    // Check on load
    fadeInOnScroll();
    
    // Check on scroll
    window.addEventListener('scroll', fadeInOnScroll);
  });

  // Scroll to top functionality
  document.addEventListener('DOMContentLoaded', function() {
    const scrollToTopBtn = document.querySelector('.scroll-to-top');
    
    window.addEventListener('scroll', function() {
      if (window.scrollY > 300) {
        scrollToTopBtn.classList.add('show');
      } else {
        scrollToTopBtn.classList.remove('show');
      }
    });
    
    scrollToTopBtn.addEventListener('click', function() {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  });
</script>

</body>
</html>