<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LoopStore – Next Gen Shopping</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  <link rel="stylesheet" href="user/homepage.css">

 
</head>

<body>

  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <a class="navbar-brand" href="/">
  <i class="bi bi-bag-fill logo-icon me-1"></i> 
  <span class="logo-text">LoopStore</span>
</a>
      
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navMenu">
        <form method="POST" action="/" class="search-bar mx-auto my-3 my-lg-0">
          <div class="search-input-group d-flex align-items-center">
            <i class="bi bi-search text-muted me-2"></i>
            <input name="search" type="text" placeholder="Search for Products, Brands and More">
          </div>
        </form>

        <ul class="navbar-nav ms-auto align-items-center gap-3">
          <li class="nav-item"><a class="nav-link" href="/allproducts"><i class="bi bi-grid"></i> Products</a></li>
          <li class="nav-item"><a class="nav-link" href="/contact"><i class="bi bi-envelope"></i> Contact</a></li>
          <li class="nav-item"><a class="nav-link" href="/profile"><i class="bi bi-person"></i> Profile</a></li>
          <li class="nav-item">
            <a href="/cart" class="btn btn-dark rounded-pill px-4">
              <i class="bi bi-cart3"></i> Cart
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <section class="hero-section">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6" data-aos="fade-right" data-aos-duration="1000">
          <span class="badge bg-white text-primary px-3 py-2 rounded-pill shadow-sm mb-3 border">
            🚀 Since 2000
          </span>
          <h1 class="hero-title">Loopstore. <br>The New Cycle.</h1>
          <p class="lead text-muted mb-4">Your one-stop shop for electronics, fashion & accessories.</p>
          <div class="d-flex gap-3">
            <a href="#shop" class="hero-btn">See Products</a>
          </div>
        </div>
        <div class="col-lg-6 mt-5 mt-lg-0 text-center position-relative" data-aos="zoom-in" data-aos-duration="1200">
          <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?q=80&w=800&auto=format&fit=crop" 
               class="img-fluid rounded-4 shadow-lg" 
               style="transform: rotate(2deg); max-height: 500px;" 
               alt="Hero Image">
        </div>
      </div>
    </div>
  </section>

  <div class="marquee-container">
    <div class="marquee-content">
      <span class="marquee-tag"><i class="bi bi-truck"></i> Free shipping on orders over $30 in USA</span>
      <span class="marquee-tag">•</span>
      <span class="marquee-tag">20% Student Discount <i class="bi bi-mortarboard-fill"></i></span>
      <span class="marquee-tag">•</span>
      <span class="marquee-tag"><i class="bi bi-tags-fill"></i> 30% off on dresses – Use code: 30OFF</span>
      <span class="marquee-tag">•</span>
      <span class="marquee-tag"><i class="bi bi-truck"></i> Free shipping on orders over $30 in USA</span>
      <span class="marquee-tag">•</span>
      <span class="marquee-tag">20% Student Discount <i class="bi bi-mortarboard-fill"></i></span>
    </div>
  </div>

  <div class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
      <h2 class="section-title m-0">Shop By Categories</h2>
      <a href="#" class="text-primary fw-bold">See All <i class="bi bi-arrow-right"></i></a>
    </div>

    <div class="row text-center g-4 justify-content-center">
      
      {{#each categories}}
      <div class="col-4 col-md-2 cat-item" data-aos="fade-up">
        <a href="#">
            <div class="cat-circle">
            <img src="{{this.image}}" alt="{{this.name}}">
            </div>
            <h6 class="fw-bold mt-2">{{this.name}}</h6>
        </a>
      </div>
      {{/each}}
      
    </div>
  </div>

  <div class="container py-5" id="shop">
    <h2 class="section-title">Top Offers</h2>
    
    <div class="row g-4 mt-2">
      
      {{#each topOffers}}
      <div class="col-md-6 col-lg-3" data-aos="fade-up">
        <a href="/singlepage/{{this._id}}" class="product-card-wrap tilt-card">
          <div class="product-card">
            <div class="product-img-box">
              <img src="{{this.images.[0]}}" alt="{{this.name}}">
            </div>
            <div class="product-cat">{{this.category.name}}</div>
            <h5 class="product-name">{{this.name}}</h5>
            <div class="price-row">
              <span class="price">₹{{this.price}}</span>
              <div class="add-btn"><i class="bi bi-plus-lg"></i></div>
            </div>
          </div>
        </a>
      </div>
      {{/each}}
      
    </div>
  </div>

  <div class="container py-5">
    <h2 class="section-title">Top Picks of the Sale</h2>
    
    <div class="row g-4 mt-2">
      
      {{#each topPicks}}
      <div class="col-md-6 col-lg-3" data-aos="fade-up">
        <a href="/singlepage/{{this._id}}" class="product-card-wrap tilt-card">
          <div class="product-card">
            <div class="product-img-box">
              <img src="{{this.images.[0]}}" alt="{{this.name}}">
            </div>
            <div class="product-cat">{{this.category.name}}</div>
            <h5 class="product-name">{{this.name}}</h5>
            <div class="price-row">
              <span class="price">₹{{this.price}}</span>
              <div class="add-btn"><i class="bi bi-plus-lg"></i></div>
            </div>
          </div>
        </a>
      </div>
      {{/each}}
      
    </div>
  </div>

  <div class="container py-5">
    <h2 class="section-title">Deals of the Day</h2>
    
    <div class="row g-4 mt-2">
      
      {{#each dealsOfDay}}
      <div class="col-md-6 col-lg-3" data-aos="fade-up">
        <a href="/singlepage/{{this._id}}" class="product-card-wrap tilt-card">
          <div class="product-card">
            <div class="product-img-box">
              <img src="{{this.images.[0]}}" alt="{{this.name}}">
            </div>
            <div class="product-cat">{{this.category.name}}</div>
            <h5 class="product-name">{{this.name}}</h5>
            <div class="price-row">
              <span class="price">₹{{this.price}}</span>
              <div class="add-btn"><i class="bi bi-plus-lg"></i></div>
            </div>
          </div>
        </a>
      </div>
      {{/each}}
      
    </div>
  </div>


  <div class="container mt-5">
    <div class="info-strip-modern" data-aos="flip-up">
      <div class="row g-4 text-center">
        <div class="col-md-3 info-box">
          <i class="bi bi-truck text-white"></i>
          <h5 class="text-white">Fast Delivery</h5>
          <small class="text-white-50">Ships same day</small>
        </div>
        <div class="col-md-3 info-box">
          <i class="bi bi-shield-check text-white"></i>
          <h5 class="text-white">Secure Payment</h5>
          <small class="text-white-50">256-bit Encryption</small>
        </div>
        <div class="col-md-3 info-box">
          <i class="bi bi-arrow-repeat text-white"></i>
          <h5 class="text-white">Easy Returns</h5>
          <small class="text-white-50">Within 30 days</small>
        </div>
        <div class="col-md-3 info-box">
          <i class="bi bi-headset text-white"></i>
          <h5 class="text-white">24x7 Support</h5>
          <small class="text-white-50">Instant response</small>
        </div>
      </div>
    </div>
  </div>

  <footer class="footer mt-5">
    <div class="container pb-5">
      <div class="row g-5">
        <div class="col-lg-4">
          <h3 class="fw-bold mb-3">LoopStore.</h3>
          <p class="text-muted">Your one-stop shop for electronics, fashion & accessories.</p>
          <div class="d-flex gap-3 mt-4">
            <a href="#"><i class="bi bi-facebook fs-4 text-muted"></i></a>
            <a href="#"><i class="bi bi-instagram fs-4 text-muted"></i></a>
            <a href="#"><i class="bi bi-twitter fs-4 text-muted"></i></a>
          </div>
        </div>
        <div class="col-lg-2 col-6">
          <h6 class="fw-bold mb-3">Customer Service</h6>
          <ul class="list-unstyled text-muted d-grid gap-2">
            <li><a href="/contact">Contact</a></li>
            <li><a href="#">Refund Policy</a></li>
            <li><a href="#">Track Order</a></li>
          </ul>
        </div>
        <div class="col-lg-2 col-6">
          <h6 class="fw-bold mb-3">Categories</h6>
          <ul class="list-unstyled text-muted d-grid gap-2">
            <li><a href="/usercategorypage?cat=Electronics">Electronics</a></li>
            <li><a href="/usercategorypage?cat=Fashion">Fashion</a></li>
            <li><a href="/usercategorypage?cat=Home & Kitchen">Home & Kitchen</a></li>
          </ul>
        </div>
        <div class="col-lg-4">
          <h6 class="fw-bold mb-3">Contact</h6>
          <p class="text-muted"><i class="bi bi-geo-alt"></i> Chennai, Tamil Nadu</p>
          <p class="text-muted"><i class="bi bi-telephone"></i> +91 98765 43210</p>
          <p class="text-muted"><i class="bi bi-envelope"></i> support@loopstore.com</p>
        </div>
      </div>
      <div class="border-top mt-5 pt-4 text-center text-muted">
        <small>© 2025 LoopStore – All Rights Reserved</small>
      </div>
    </div>
  </footer>

  <a href="#" class="scroll-to-top"><i class="bi bi-arrow-up"></i></a>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

  <script>
    // 1. Initialize Animate On Scroll (AOS)
    AOS.init({
      once: true,
      offset: 100,
      duration: 800,
    });

    // 2. Scroll to Top & Navbar Logic
    const scrollBtn = document.querySelector('.scroll-to-top');
    const navbar = document.querySelector('.navbar');

    window.addEventListener('scroll', () => {
      // Navbar Styling
      if (window.scrollY > 50) {
        navbar.style.boxShadow = "0 10px 30px rgba(0,0,0,0.1)";
        navbar.style.padding = "0.5rem 0";
      } else {
        navbar.style.boxShadow = "none";
        navbar.style.padding = "1rem 0";
      }

      // Scroll Button visibility
      if (window.scrollY > 400) {
        scrollBtn.classList.add('active');
      } else {
        scrollBtn.classList.remove('active');
      }
    });

    // 3. Scripted Model: 3D Tilt Effect (Vanilla JS)
    const cards = document.querySelectorAll('.tilt-card');

    cards.forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const cardInner = card.querySelector('.product-card');
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        // Calculate rotation
        const xRotation = -((y - rect.height / 2) / 20); 
        const yRotation = (x - rect.width / 2) / 20;

        // Apply Transform
        cardInner.style.transform = `perspective(1000px) rotateX(${xRotation}deg) rotateY(${yRotation}deg) scale(1.02)`;
        cardInner.style.boxShadow = "0 20px 50px rgba(0,0,0,0.15)";
      });

      card.addEventListener('mouseleave', () => {
        const cardInner = card.querySelector('.product-card');
        // Reset
        cardInner.style.transform = `perspective(1000px) rotateX(0) rotateY(0) scale(1)`;
        cardInner.style.boxShadow = "none";
      });
    });

    // 4. Scroll to top button click handler
    scrollBtn.addEventListener('click', function() {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    });
  </script>
</body>
</html>