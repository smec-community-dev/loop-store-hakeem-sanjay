<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Contact Us - LookMe</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background-color: #f1f3f6;
    }

    /* NAVBAR */
    .topbar {
      background: #fff;
      box-shadow: 0 1px 4px rgba(0,0,0,0.1);
      padding: 10px 0;
    }
    .navbar-brand {
      font-weight: 700;
      color: #2874f0 !important;
    }
    .navbar-brand span {
      color: #ffc107;
    }
    .nav-link {
      color: #333 !important;
      font-weight: 500;
    }
    .nav-link:hover {
      color: #2874f0 !important;
    }

    /* CONTACT SECTION */
    .contact-container {
      background: white;
      border-radius: 10px;
      padding: 40px;
      margin-top: 40px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .contact-info i {
      color: #2874f0;
      font-size: 1.5rem;
      margin-right: 10px;
    }
    .form-control:focus {
      border-color: #2874f0;
      box-shadow: none;
    }
    .btn-send {
      background-color: #2874f0;
      color: white;
      font-weight: 600;
      padding: 10px 25px;
      border: none;
      border-radius: 6px;
    }
    .btn-send:hover {
      background-color: #1f5ec1;
    }

    iframe {
      border-radius: 10px;
      width: 100%;
      height: 300px;
      border: 0;
    }

    footer {
      background-color: #172337;
      color: white;
      padding: 40px 0;
      margin-top: 60px;
    }
  </style>
</head>
<body>

  <!-- ===== NAVBAR ===== -->
  <nav class="navbar navbar-expand-lg topbar">
    <div class="container">
      <a class="navbar-brand" href="index.html">LookMe <span>Explore Plus ✨</span></a>
      <ul class="navbar-nav ms-auto align-items-center">
        <li class="nav-item"><a class="nav-link" href="index.html"><i class="bi bi-house"></i> Home</a></li>
        <li class="nav-item"><a class="nav-link" href="cart.html"><i class="bi bi-cart3"></i> Cart</a></li>
        <li class="nav-item"><a class="nav-link active" href="#"><i class="bi bi-envelope"></i> Contact</a></li>
      </ul>
    </div>
  </nav>

  <!-- ===== CONTACT SECTION ===== -->
  <div class="container contact-container">
    <div class="row g-4 align-items-center">
      <!-- LEFT INFO -->
      <div class="col-md-6">
        <h3 class="fw-bold mb-4 text-primary">Get in Touch with LookMe</h3>
        <p class="text-muted mb-4">
          Have questions, feedback, or need help? Our customer support team is here 24/7 to assist you.  
          Feel free to reach out to us via the form or contact details below.
        </p>

        <div class="contact-info mb-3">
          <p><i class="bi bi-geo-alt-fill"></i> <strong>Address:</strong> 123 Market Street, Chennai, India</p>
          <p><i class="bi bi-telephone-fill"></i> <strong>Phone:</strong> +91 98765 43210</p>
          <p><i class="bi bi-envelope-fill"></i> <strong>Email:</strong> support@lookme.in</p>
          <p><i class="bi bi-clock-fill"></i> <strong>Hours:</strong> Mon–Sat, 9:00 AM – 9:00 PM</p>
        </div>

        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3915.6403709758474!2d80.20116627447147!3d13.082680989808306!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a5265ce4188f51b%3A0xf28b9a82a4b48bb7!2sChennai%2C%20Tamil%20Nadu!5e0!3m2!1sen!2sin!4v1709987500000!5m2!1sen!2sin" allowfullscreen></iframe>
      </div>

      <!-- RIGHT FORM -->
      <div class="col-md-6">
        <h4 class="fw-semibold mb-3">Send Us a Message</h4>
        <form>
          <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input type="text" class="form-control" placeholder="Enter your name" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" placeholder="Enter your email" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Subject</label>
            <input type="text" class="form-control" placeholder="Order / Refund / Other">
          </div>
          <div class="mb-3">
            <label class="form-label">Message</label>
            <textarea rows="5" class="form-control" placeholder="Write your message here..." required></textarea>
          </div>
          <button type="submit" class="btn-send">Send Message</button>
        </form>
      </div>
    </div>
  </div>

  <!-- ===== FOOTER ===== -->
  <footer class="text-center">
    <div class="container">
      <p class="mb-0">© 2025 LookMe </p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
