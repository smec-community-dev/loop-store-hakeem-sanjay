<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Login - ShopHub</title>
    <link rel="stylesheet" href="/user/login.css">

    <style>
        /* Google Button Styling */
        .google-btn {
            margin-top: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            background-color: #ffffff;
            border: 1px solid #ddd;
            padding: 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 500;
            transition: background 0.2s ease-in-out;
            text-decoration: none;
            color: #333;
        }

        .google-btn:hover {
            background-color: #f1f1f1;
        }

        .google-icon {
            width: 20px;
            height: 20px;
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="navbar-brand">
                <a href="/" class="logo">Loopstore</a>
            </div>
        </div>
    </nav>

    <!-- Login Section -->
    <main class="auth-section">
        <div class="auth-container">

            <!-- Login Card -->
            <div class="auth-card">

                <h1 class="auth-heading">User Login</h1>
                <p class="auth-subtitle">Access your ShopHub account</p>

                <form class="auth-form" id="loginForm" method="post">

                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="you@example.com" required>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="Enter your password" required>
                    </div>

                    <button type="submit" class="btn btn-primary btn-full">Login</button>

                    <!-- Register -->
                    <p class="auth-bottom-text">
                        Don't have an account?
                        <a href="/register">Register</a>
                    </p>

                </form>

                <!-- 🔥 GOOGLE LOGIN BUTTON -->
                <a href="/auth/google" class="google-btn">
                    <img class="google-icon" src="https://upload.wikimedia.org/wikipedia/commons/5/53/Google_%22G%22_Logo.svg">
                    Continue with Google
                </a>

            </div>

            <!-- Right Illustration -->
            <div class="auth-image">
                <div class="auth-illustration">
                    <div class="illustration-circle"></div>
                    <h2>Shop with Confidence</h2>
                    <p>Access exclusive deals and manage your orders</p>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; 2025 ShopHub. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>
