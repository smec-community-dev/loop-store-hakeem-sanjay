<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Success - LookMe</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="/user/ordersuccess.css">
</head>

<body>

    <div class="success-box">

        <i class="bi bi-check-circle-fill success-icon"></i>

        <h2 class="mt-3">Order Placed Successfully!</h2>
        <p class="text-muted">Thank you for shopping with LookMe.</p>

        <!-- ORDER SUMMARY -->
        <div class="order-card">
            <h5 class="mb-3">Order Summary</h5>

            <table class="table order-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Qty</th>
                        <th class="text-end">Price</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each order.items}}
                    <tr>
                        <td>{{this.product.name}}</td>
                        <td class="text-end">{{this.quantity}}</td>
                        <td class="text-end">₹{{this.product.price}}</td>
                        <td class="text-end">₹{{multiply this.quantity this.product.price}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>

            <hr>

            <div class="d-flex justify-content-between fw-bold total-paid">
                <span>Total Paid</span>
                <span class="total-price">₹{{order.totalPrice}}</span>
            </div>
        </div>

        <!-- DELIVERY ADDRESS -->
        <div class="address-box mt-3">
            <h5 class="mb-3">Delivery Address</h5>

            <p class="mb-1"><strong>{{address.address.name}}</strong></p>
            <p class="mb-1">
                {{address.address.house}}, {{address.address.street}}
            </p>
            <p class="mb-1">
                {{address.address.city}}, {{address.address.state}} - {{address.address.pincode}}
            </p>
            <p class="mb-0">Phone: {{address.address.phone}}</p>
        </div>

        <a href="/" class="btn-home mt-4">Continue Shopping</a>

    </div>

</body>

</html>
