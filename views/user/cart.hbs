<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Cart - LoopStore</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/user/cart.css">
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar">
    <div class="container">
        <a href="/" class="logo">LoopStore</a>
        <ul class="nav-links">
            <li><a href="/profile"><i class="fas fa-user"></i> Profile</a></li>
            <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
        </ul>
    </div>
</nav>

<main class="cart-section">
    <div class="container">

        <h1>Your Shopping Cart</h1>

        {{!-- If cart has items --}}
        {{#if items.length}}

        <div class="cart-wrapper">

            <!-- CART ITEMS -->
            <section class="cart-items">

                <div class="cart-header">
                    <span><i class="fas fa-shopping-cart"></i> {{items.length}} item(s) in your cart</span>
                    <a href="/" class="continue">
                        <i class="fas fa-arrow-left"></i> Continue Shopping
                    </a>
                </div>

                {{!-- LOOP ALL ITEMS --}}
                {{#each items}}
                <div class="cart-item">

                    <!-- PRODUCT IMAGE -->
                    <div class="item-image">
                        <img src="{{this.product.images.[0]}}" alt="{{this.product.name}}">
                    </div>

                    <!-- PRODUCT DETAILS -->
                    <div class="item-details">
                        <h3>{{this.product.name}}</h3>
                        <p>{{this.product.description}}</p>

                        {{#if this.product.seller}}
                        <p class="seller"><i class="fas fa-store"></i> Seller: {{this.product.seller.name}}</p>
                        {{/if}}
                        
                        <div class="save-later">
                            <i class="far fa-bookmark"></i> Save for later
                        </div>
                    </div>

                    <!-- QUANTITY -->
                    <div class="item-quantity">
                        <label>Quantity: {{this.quantity}}</label>
                       
                    </div>

                    <!-- PRICE -->
                    <div class="item-price">
                        <p class="price">₹{{this.priceAtAddTime}}</p>
                        <p class="subtotal">Subtotal: ₹{{multiply this.quantity this.priceAtAddTime}}</p>
                    </div>

                    <!-- REMOVE BUTTON -->
                    <a href="/cart/remove/{{this.product._id}}" class="btn-remove" title="Remove item">
                        <i class="fas fa-times"></i>
                    </a>

                </div>
                {{/each}}

            </section>

            <!-- SUMMARY -->
            <aside class="cart-summary">
                <div class="summary-card">
                    <h2>Order Summary</h2>

                    <div class="summary-row">
                        <span>Subtotal ({{items.length}} items):</span>
                        <span>₹{{totalPrice}}</span>
                    </div>

                    <div class="summary-row">
                        <span>Shipping:</span>
                        <span>FREE</span>
                    </div>
                    <div class="summary-row summary-total">
                        <span>Total:</span>
                        <span>₹{{totalPrice}}</span>
                    </div>
                    
                    <form action="/cartorder">
                        <button type="submit" class="btn-primary">
                            <i class="fas fa-lock"></i> Proceed to Checkout
                        </button>
                    </form>
                    
                    <div class="secure-checkout">
                        <p style="text-align: center; margin-top: 15px; font-size: 0.9rem; color: var(--gray-600);">
                            <i class="fas fa-shield-alt"></i> Secure checkout guaranteed
                        </p>
                    </div>
                </div>
            </aside>

        </div>

        {{!-- NO ITEMS --}}
        {{else}}
        <div class="empty-cart">
            <i class="fas fa-shopping-cart"></i>
            <h2>Your cart is empty</h2>
            <p>Looks like you haven't added anything to your cart yet.</p>
            <a href="/" class="btn-primary">
                <i class="fas fa-shopping-bag"></i> Start Shopping
            </a>
        </div>
        {{/if}}

    </div>
</main>

<footer class="footer">
    <p>© 2025 LoopStore. All rights reserved.</p>
</footer>

<script>
    // Simple quantity control simulation (would need backend integration in real app)
    document.querySelectorAll('.qty-btn').forEach(button => {
        button.addEventListener('click', function() {
            const input = this.parentElement.querySelector('input');
            let value = parseInt(input.value);
            
            if (this.classList.contains('plus')) {
                value++;
            } else if (this.classList.contains('minus') && value > 1) {
                value--;
            }
            
            input.value = value;
            
            // In a real app, you would send an AJAX request to update the cart
            console.log(`Quantity updated to: ${value}`);
        });
    });

    // Save for later functionality
    document.querySelectorAll('.save-later').forEach(item => {
        item.addEventListener('click', function() {
            const productName = this.closest('.cart-item').querySelector('h3').textContent;
            alert(`"${productName}" has been saved for later!`);
            // In a real app, you would send an AJAX request to move item to saved list
        });
    });

    // Promo code application
    document.querySelector('.promo-input button').addEventListener('click', function() {
        const promoInput = document.querySelector('.promo-input input');
        if (promoInput.value.trim() !== '') {
            alert(`Promo code "${promoInput.value}" applied!`);
            promoInput.value = '';
        } else {
            alert('Please enter a promo code');
        }
    });
</script>

</body>
</html>