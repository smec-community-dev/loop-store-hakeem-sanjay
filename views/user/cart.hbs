<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Cart - LoopStore</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* ============================
           CSS VARIABLES & RESET
        ============================= */
        :root {
            --primary: #3917e4;
            --primary-dark: #3917e4;
            --secondary: #6c757d;
            --success: #28a745;
            --danger: #dc3545;
            --warning: #3917e4;
            --info: #17a2b8;
            --light: #f8f9fa;
            --dark: #343a40;
            --white: #ffffff;
            --gray-100: #f8f9fa;
            --gray-200: #e9ecef;
            --gray-300: #dee2e6;
            --gray-400: #ced4da;
            --gray-500: #adb5bd;
            --gray-600: #6c757d;
            --gray-700: #495057;
            --gray-800: #343a40;
            --gray-900: #212529;
            --border-radius: 12px;
            --shadow: 0 4px 12px rgba(0,0,0,0.08);
            --shadow-hover: 0 8px 24px rgba(0,0,0,0.12);
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* ============================
           GLOBAL STYLES
        ============================= */
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
            color: var(--gray-800);
            line-height: 1.6;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .container {
            width: 90%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 15px;
        }

        h1, h2, h3, h4, h5 {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            color: var(--gray-900);
        }

        /* ============================
           NAVBAR IMPROVEMENTS
        ============================= */
        .navbar {
            background: var(--primary);
            padding: 16px 0;
            box-shadow: 0 2px 12px rgba(0,0,0,0.1);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: var(--white);
            font-size: 1.8rem;
            font-weight: 700;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo:before {
            content: "🛒";
            font-size: 1.6rem;
        }

        .nav-links {
            list-style: none;
            display: flex;
            gap: 28px;
            align-items: center;
        }

        .nav-links a {
            color: var(--white);
            text-decoration: none;
            font-weight: 600;
            font-size: 1rem;
            transition: var(--transition);
            padding: 8px 12px;
            border-radius: 8px;
        }

        .nav-links a:hover {
            background: rgba(255,255,255,0.15);
            transform: translateY(-1px);
        }

        /* ============================
           CART SECTION IMPROVEMENTS
        ============================= */
        .cart-section {
            padding: 40px 0 60px;
            flex: 1;
        }

        .cart-section h1 {
            font-size: 2.2rem;
            margin-bottom: 30px;
            text-align: center;
            color: var(--gray-900);
            position: relative;
            display: inline-block;
            width: 100%;
        }

        .cart-section h1:after {
            content: "";
            display: block;
            width: 80px;
            height: 4px;
            background: var(--primary);
            margin: 10px auto 0;
            border-radius: 2px;
        }

        /* ============================
           CART WRAPPER
        ============================= */
        .cart-wrapper {
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 30px;
            align-items: start;
        }

        /* ============================
           CART ITEMS IMPROVEMENTS
        ============================= */
        .cart-items {
            background: var(--white);
            border-radius: var(--border-radius);
            padding: 30px;
            box-shadow: var(--shadow);
        }

        .cart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--gray-200);
        }

        .cart-header span {
            font-weight: 600;
            color: var(--gray-700);
            font-size: 1.1rem;
        }

        .continue {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: var(--transition);
        }

        .continue:hover {
            color: var(--primary-dark);
            transform: translateX(3px);
        }

        /* ============================
           CART ITEM IMPROVEMENTS
        ============================= */
        .cart-item {
            display: grid;
            grid-template-columns: 120px 1fr auto auto;
            gap: 20px;
            align-items: center;
            padding: 25px 0;
            border-bottom: 1px solid var(--gray-200);
            transition: var(--transition);
        }

        .cart-item:hover {
            background: rgba(0,0,0,0.02);
            border-radius: 8px;
            padding-left: 15px;
            padding-right: 15px;
        }

        .item-image {
            position: relative;
        }

        .item-image img {
            width: 100%;
            height: 100px;
            object-fit: contain;
            border-radius: 10px;
            background: var(--gray-100);
            padding: 8px;
            border: 1px solid var(--gray-200);
            transition: var(--transition);
        }

        .cart-item:hover .item-image img {
            transform: scale(1.05);
        }

        .item-details {
            padding-right: 15px;
        }

        .item-details h3 {
            font-size: 1.2rem;
            margin-bottom: 8px;
            color: var(--gray-900);
        }

        .item-details p {
            color: var(--gray-600);
            font-size: 0.95rem;
            margin-bottom: 5px;
            line-height: 1.5;
        }

        .seller {
            color: var(--primary) !important;
            font-weight: 600;
            font-size: 0.9rem !important;
        }

        .item-quantity {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .item-quantity label {
            font-weight: 600;
            color: var(--gray-700);
            font-size: 0.95rem;
        }

        .quantity-control {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 5px;
        }

        .qty-btn {
            width: 32px;
            height: 32px;
            border: 1px solid var(--gray-300);
            background: var(--white);
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .qty-btn:hover {
            background: var(--gray-100);
            border-color: var(--gray-400);
        }

        .item-quantity input {
            width: 50px;
            text-align: center;
            padding: 8px;
            border-radius: 8px;
            border: 1px solid var(--gray-300);
            font-weight: 600;
            font-size: 1rem;
        }

        .item-price {
            text-align: right;
            min-width: 140px;
        }

        .price {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 5px;
        }

        .subtotal {
            color: var(--gray-600);
            font-size: 0.9rem;
            font-weight: 500;
        }

        .btn-remove {
            color: var(--danger);
            font-size: 1.4rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            transition: var(--transition);
            margin-top: 10px;
        }

        .btn-remove:hover {
            background: rgba(220, 53, 69, 0.1);
            transform: scale(1.1);
        }

        /* ============================
           CART SUMMARY IMPROVEMENTS
        ============================= */
        .cart-summary {
            position: sticky;
            top: 100px;
        }

        .summary-card {
            background: var(--white);
            padding: 25px;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            border: 1px solid var(--gray-200);
        }

        .summary-card h2 {
            font-size: 1.5rem;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--gray-200);
            color: var(--gray-900);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin: 15px 0;
            font-size: 1rem;
        }

        .summary-total {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary);
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid var(--gray-200);
        }

        /* ============================
           BUTTON IMPROVEMENTS
        ============================= */
        .btn-primary {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: var(--primary);
            color: var(--white);
            border: none;
            width: 100%;
            padding: 16px;
            border-radius: 10px;
            margin-top: 25px;
            cursor: pointer;
            font-weight: 700;
            font-size: 1.1rem;
            transition: var(--transition);
            text-decoration: none;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(255, 159, 0, 0.3);
        }

        /* ============================
           EMPTY CART STYLING
        ============================= */
        .empty-cart {
            text-align: center;
            padding: 60px 20px;
            background: var(--white);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            margin: 30px 0;
        }

        .empty-cart i {
            font-size: 5rem;
            color: var(--gray-300);
            margin-bottom: 20px;
        }

        .empty-cart h2 {
            font-size: 1.8rem;
            margin-bottom: 15px;
            color: var(--gray-700);
        }

        .empty-cart p {
            color: var(--gray-600);
            margin-bottom: 30px;
            font-size: 1.1rem;
        }

        /* ============================
           FOOTER IMPROVEMENTS
        ============================= */
        .footer {
            text-align: center;
            padding: 25px;
            background: var(--gray-900);
            color: var(--white);
            margin-top: auto;
        }

        .footer p {
            margin: 0;
            font-size: 0.95rem;
        }

        /* ============================
           RESPONSIVE DESIGN
        ============================= */
        @media (max-width: 1024px) {
            .cart-wrapper {
                grid-template-columns: 1fr;
                gap: 25px;
            }
            
            .cart-summary {
                position: static;
            }
        }

        @media (max-width: 768px) {
            .cart-item {
                grid-template-columns: 100px 1fr;
                gap: 15px;
            }
            
            .item-quantity, .item-price, .btn-remove {
                grid-column: 2;
                justify-self: start;
                margin-top: 10px;
            }
            
            .item-price {
                text-align: left;
            }
            
            .btn-remove {
                position: absolute;
                top: 25px;
                right: 0;
            }
            
            .cart-header {
                flex-direction: column;
                gap: 15px;
                align-items: flex-start;
            }
            
            .nav-links {
                gap: 15px;
            }
        }

        @media (max-width: 576px) {
            .container {
                width: 95%;
                padding: 0 10px;
            }
            
            .cart-items {
                padding: 20px;
            }
            
            .cart-item {
                position: relative;
                padding: 20px 0;
            }
            
            .item-details h3 {
                font-size: 1.1rem;
            }
            
            .navbar .container {
                flex-direction: column;
                gap: 15px;
            }
            
            .nav-links {
                width: 100%;
                justify-content: center;
            }
        }

        /* ============================
           ANIMATIONS
        ============================= */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .cart-item {
            animation: fadeIn 0.5s ease;
        }

        /* ============================
           ADDITIONAL FEATURES
        ============================= */
        .save-later {
            margin-top: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--gray-600);
            font-size: 0.9rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .save-later:hover {
            color: var(--primary);
        }

        .discount-badge {
            background: var(--success);
            color: var(--white);
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
            margin-left: 10px;
        }

        .promo-section {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px dashed var(--gray-300);
        }

        .promo-input {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        .promo-input input {
            flex: 1;
            padding: 12px;
            border: 1px solid var(--gray-300);
            border-radius: 8px;
            font-size: 1rem;
        }

        .promo-input button {
            background: var(--gray-700);
            color: var(--white);
            border: none;
            padding: 0 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
        }

        .promo-input button:hover {
            background: var(--gray-800);
        }
    </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar">
    <div class="container">
        <a href="/" class="logo">LoopStore</a>
        <ul class="nav-links">
            <li><a href="/profile"><i class="fas fa-user"></i> Profile</a></li>
            <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
        </ul>
    </div>
</nav>

<main class="cart-section">
    <div class="container">

        <h1>Your Shopping Cart</h1>

        {{!-- If cart has items --}}
        {{#if items.length}}

        <div class="cart-wrapper">

            <!-- CART ITEMS -->
            <section class="cart-items">

                <div class="cart-header">
                    <span><i class="fas fa-shopping-cart"></i> {{items.length}} item(s) in your cart</span>
                    <a href="/" class="continue">
                        <i class="fas fa-arrow-left"></i> Continue Shopping
                    </a>
                </div>

                {{!-- LOOP ALL ITEMS --}}
                {{#each items}}
                <div class="cart-item">

                    <!-- PRODUCT IMAGE -->
                    <div class="item-image">
                        <img src="{{this.product.images.[0]}}" alt="{{this.product.name}}">
                    </div>

                    <!-- PRODUCT DETAILS -->
                    <div class="item-details">
                        <h3>{{this.product.name}}</h3>
                        <p>{{this.product.description}}</p>

                        {{#if this.product.seller}}
                        <p class="seller"><i class="fas fa-store"></i> Seller: {{this.product.seller.name}}</p>
                        {{/if}}
                        
                        <div class="save-later">
                            <i class="far fa-bookmark"></i> Save for later
                        </div>
                    </div>

                    <!-- QUANTITY -->
                    <div class="item-quantity">
                        <label>Quantity: {{this.quantity}}</label>
                       
                    </div>

                    <!-- PRICE -->
                    <div class="item-price">
                        <p class="price">₹{{this.priceAtAddTime}}</p>
                        <p class="subtotal">Subtotal: ₹{{multiply this.quantity this.priceAtAddTime}}</p>
                    </div>

                    <!-- REMOVE BUTTON -->
                    <a href="/cart/remove/{{this.product._id}}" class="btn-remove" title="Remove item">
                        <i class="fas fa-times"></i>
                    </a>

                </div>
                {{/each}}

            </section>

            <!-- SUMMARY -->
            <aside class="cart-summary">
                <div class="summary-card">
                    <h2>Order Summary</h2>

                    <div class="summary-row">
                        <span>Subtotal ({{items.length}} items):</span>
                        <span>₹{{totalPrice}}</span>
                    </div>

                    <div class="summary-row">
                        <span>Shipping:</span>
                        <span>₹49</span>
                    </div>

                

                    <div class="promo-section">
                        <div class="summary-row">
                            <span>Discount <span class="discount-badge">SAVE10</span>:</span>
                            <span>-₹{{multiply totalPrice 0.1}}</span>
                        </div>
                        
                        <div class="promo-input">
                            <input type="text" placeholder="Enter promo code">
                            <button>Apply</button>
                        </div>
                    </div>

                    <div class="summary-row summary-total">
                        <span>Total:</span>
                        <span>₹{{sum totalPrice 49}}</span>
                    </div>
                    
                    <form action="/cartorder">
                        <button type="submit" class="btn-primary">
                            <i class="fas fa-lock"></i> Proceed to Checkout
                        </button>
                    </form>
                    
                    <div class="secure-checkout">
                        <p style="text-align: center; margin-top: 15px; font-size: 0.9rem; color: var(--gray-600);">
                            <i class="fas fa-shield-alt"></i> Secure checkout guaranteed
                        </p>
                    </div>
                </div>
            </aside>

        </div>

        {{!-- NO ITEMS --}}
        {{else}}
        <div class="empty-cart">
            <i class="fas fa-shopping-cart"></i>
            <h2>Your cart is empty</h2>
            <p>Looks like you haven't added anything to your cart yet.</p>
            <a href="/" class="btn-primary">
                <i class="fas fa-shopping-bag"></i> Start Shopping
            </a>
        </div>
        {{/if}}

    </div>
</main>

<footer class="footer">
    <p>© 2025 LoopStore. All rights reserved.</p>
</footer>

<script>
    // Simple quantity control simulation (would need backend integration in real app)
    document.querySelectorAll('.qty-btn').forEach(button => {
        button.addEventListener('click', function() {
            const input = this.parentElement.querySelector('input');
            let value = parseInt(input.value);
            
            if (this.classList.contains('plus')) {
                value++;
            } else if (this.classList.contains('minus') && value > 1) {
                value--;
            }
            
            input.value = value;
            
            // In a real app, you would send an AJAX request to update the cart
            console.log(`Quantity updated to: ${value}`);
        });
    });

    // Save for later functionality
    document.querySelectorAll('.save-later').forEach(item => {
        item.addEventListener('click', function() {
            const productName = this.closest('.cart-item').querySelector('h3').textContent;
            alert(`"${productName}" has been saved for later!`);
            // In a real app, you would send an AJAX request to move item to saved list
        });
    });

    // Promo code application
    document.querySelector('.promo-input button').addEventListener('click', function() {
        const promoInput = document.querySelector('.promo-input input');
        if (promoInput.value.trim() !== '') {
            alert(`Promo code "${promoInput.value}" applied!`);
            promoInput.value = '';
        } else {
            alert('Please enter a promo code');
        }
    });
</script>

</body>
</html>