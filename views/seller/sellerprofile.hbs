    <script>
        document.querySelectorAll('.seller-link').forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                document.querySelectorAll('.seller-tab').forEach(tab => {
                    tab.classList.remove('active');
                });
                document.querySelectorAll('.seller-link').forEach(l => {
                    l.classList.remove('active');
                });
                const target = link.getAttribute('href').substring(1);
                document.getElementById(target).classList.add('active');
                link.classList.add('active');
            });
        });

// MULTI IMAGE PREVIEW
document.querySelector('input[name="productImages"]').addEventListener("change", function (e) {
    let container = document.getElementById("imagePreviewContainer");
    container.innerHTML = "";

    [...e.target.files].forEach(file => {
        let reader = new FileReader();
        reader.onload = ev => {
            let img = document.createElement("img");
            img.src = ev.target.result;
            img.style.height = "100px";
            img.style.borderRadius = "8px";
            img.style.margin = "5px";
            container.appendChild(img);
        };
        reader.readAsDataURL(file);
    });
});

// ADD SPECIFICATION FIELDS
document.getElementById("addSpecBtn").addEventListener("click", () => {
    const container = document.getElementById("specificationsContainer");

    const row = document.createElement("div");
    row.classList.add("d-flex", "gap-2", "mb-2");

    row.innerHTML = `
        <input type="text" name="specKey[]" class="form-control" placeholder="Key (e.g. RAM)">
        <input type="text" name="specValue[]" class="form-control" placeholder="Value (e.g. 16GB)">
        <button type="button" class="btn btn-danger btn-sm removeSpec">X</button>
    `;
    
    container.appendChild(row);

    // Remove button
    row.querySelector(".removeSpec").addEventListener("click", () => row.remove());
});



    </script>
