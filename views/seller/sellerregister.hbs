<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Registration - ShopHub</title>
    <link rel="stylesheet" href="/seller/seller-register.css">
</head>
<body>

<main class="auth-section">
    <div class="auth-container">

        <!-- Form Section -->
        <div class="auth-card">

            <h1>Seller Registration</h1>
            <p class="auth-subtitle">Create your account to continue</p>

            <form method="post" action="/seller/register" >

                <div class="form-group" >
                    <label for="firstName">Business  Name</label>
                    <input type="text" id="firstName" name="businessname" placeholder="John" required>
                </div>

                <div class="form-group">
                    <label for="regEmail">Email Address</label>
                    <input type="email" id="regEmail" name="email" placeholder="you@example.com" required>
                </div>

                <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="tel" id="phone" name="phone" placeholder="9876543210" required>
                </div>

                <!-- NEW: LOCATION FIELD -->
                <div class="form-group">
                    <label for="location">Business Location</label>
                    <input type="text" id="location" name="location" placeholder="City, State" required>
                </div>

                <!-- NEW: SELLER DESCRIPTION FIELD -->
                <div class="form-group">
                    <label for="seller_description">Seller Description</label>
                    <textarea id="seller_description" name="seller_description" placeholder="Tell us about your shop..." required></textarea>
                </div>

                <div class="form-group">
                    <label for="regPassword">Password</label>
                    <input type="password" id="regPassword" name="password" placeholder="Enter password" required>
                </div>

                <button type="submit" class="btn-primary btn-full">Create Account</button>

                <p class="auth-bottom-text">
                    Already have an account?
                    <a href="/seller/login">Login</a>
                </p>

            </form>
        </div>

        <!-- Right Side Image -->
        <div class="auth-image">
            <div class="illustration-wrapper">
                <img 
                    src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0" 
                    class="illustration-img" 
                    alt="Shopping Image"
                >
            </div>

            <h2>Start Your Journey</h2>
            <p>Sign up today and explore thousands of products</p>
        </div>

    </div>
</main>

</body>
</html>
